@@ -634,6 +634,21 @@ static void check_trace_handlers(void) {
     rvg_trace_range_handler_release(NULL);
 }
 
+/* The optional video boundary refuses missing inputs without touching outputs.
+ * Extension selection cannot change after check_device has opened a GPU. */
+static void check_video_refusals(void) {
+    RvgVideoEndpoint *endpoint = (RvgVideoEndpoint *)(uintptr_t)0x1234;
+    CHECK_STATUS(rvg_video_gpu_import_enable(), RVG_ERR_UNSUPPORTED);
+    CHECK_STATUS(rvg_video_endpoint_create(NULL, &endpoint), RVG_ERR_INVALID_ARGUMENT);
+    CHECK(endpoint == (RvgVideoEndpoint *)(uintptr_t)0x1234);
+    rvg_video_endpoint_release(NULL);
+    CHECK_STATUS(rvg_video_target_arm(NULL), RVG_ERR_INVALID_ARGUMENT);
+    uint32_t state = 0x1234;
+    CHECK_STATUS(rvg_video_target_state(NULL, &state), RVG_ERR_INVALID_ARGUMENT);
+    CHECK(state == 0x1234);
+    CHECK_STATUS(rvg_video_target_disarm(NULL), RVG_ERR_INVALID_ARGUMENT);
+}
+
 int main(int argc, char **argv) {
 #ifdef _WIN32
     main_thread = GetCurrentThreadId();
@@ -671,6 +686,7 @@ int main(int argc, char **argv) {
     check_device();
     check_iosurface();
     check_trace_handlers();
+    check_video_refusals();
     if (failures) {
         fprintf(stderr, "harness: %d failures\n", failures);
         return 1;
