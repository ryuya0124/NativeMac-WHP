+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::thread::{self, JoinHandle};
+use std::time::Duration;
+
+use crate::video_targets;
+use std::collections::BTreeSet;
+
+struct Reservations(BTreeSet<video_targets::Capability>);
+impl Drop for Reservations {
+    fn drop(&mut self) {
+        for capability in &self.0 {
+            video_targets::disarm(*capability);
+        }
+    }
+}
+
+/// An owned host loopback endpoint. Dropping it closes its listener and joins
+/// the listener thread and its at most two connection threads. Metadata reads
+/// are bounded, idle reads notice shutdown within 100 ms, and a GPU operation
+/// has its own completion deadline. Request allocation is fixed in size.
+pub struct Endpoint {
+    stopped: Arc<AtomicBool>,
+    listener: Option<JoinHandle<()>>,
+}
+
+impl Endpoint {
+    /// Starts on one explicit nonprivileged loopback port with a nonzero
+    /// 256-bit key. This does not enable GPU memory imports or media transport.
+    pub fn start(port: u16, secret: [u8; 32]) -> std::io::Result<Self> {
+        if port < 1024 || secret == [0; 32] {
+            return Err(std::io::Error::other("invalid video control configuration"));
+        }
+        let socket = TcpListener::bind(SocketAddrV4::new(Ipv4Addr::LOCALHOST, port))?;
+        socket.set_nonblocking(true)?;
+        let stopped = Arc::new(AtomicBool::new(false));
+        let stop = Arc::clone(&stopped);
+        let listener = thread::Builder::new()
+            .name("reims-vgpu.video-control".to_owned())
+            .spawn(move || {
+                let mut workers: Vec<JoinHandle<()>> = Vec::with_capacity(2);
+                while !stop.load(Ordering::Acquire) {
+                    video_targets::reap_expired();
+                    let mut index = 0;
+                    while index < workers.len() {
+                        if workers[index].is_finished() {
+                            let _ = workers.swap_remove(index).join();
+                        } else {
+                            index += 1;
+                        }
+                    }
+                    match socket.accept() {
+                        Ok((connection, _)) => {
+                            if workers.len() >= 2 {
+                                continue;
+                            }
+                            let stop = Arc::clone(&stop);
+                            let result = thread::Builder::new()
+                                .name("reims-vgpu.video-request".to_owned())
+                                .spawn(move || {
+                                    let _ = serve(connection, secret, &stop);
+                                });
+                            if let Ok(worker) = result {
+                                workers.push(worker);
+                            }
+                        }
+                        Err(error) if error.kind() == std::io::ErrorKind::WouldBlock => {
+                            thread::sleep(Duration::from_millis(20))
+                        }
+                        Err(_) => break,
+                    }
+                }
+                for worker in workers {
+                    let _ = worker.join();
+                }
+            })?;
+        Ok(Self {
+            stopped,
+            listener: Some(listener),
+        })
+    }
+}
+
+impl Drop for Endpoint {
+    fn drop(&mut self) {
+        self.stopped.store(true, Ordering::Release);
+        if let Some(thread) = self.listener.take() {
+            let _ = thread.join();
+        }
+    }
+}
+
+fn serve(mut stream: TcpStream, secret: [u8; 32], stop: &AtomicBool) -> std::io::Result<()> {
+    stream.set_nodelay(true)?;
+    stream.set_read_timeout(Some(Duration::from_secs(3)))?;
+    stream.set_write_timeout(Some(Duration::from_secs(3)))?;
+    let mut hello = [0u8; 36];
+    exact(&mut stream, &mut hello, stop)?;
+    let difference = hello[4..]
+        .iter()
+        .zip(secret)
+        .fold(0u8, |value, (a, b)| value | (*a ^ b));
+    if &hello[..4] != b"NMV1" || difference != 0 {
+        return Err(std::io::Error::other("video control authentication failed"));
+    }
+    stream.write_all(b"A")?;
+    #[cfg(target_os = "windows")]
+    let mut source: Option<crate::video_sources::Source> = None;
+    let mut reservations = Reservations(BTreeSet::new());
+    // Every operation is one fixed 25-byte request. Unknown operations never
+    // interpret capability bytes as an address, path, handle or executable.
+    let started = crate::os::OsClock::new().now_mono();
+    for _ in 0..3_000_000 {
+        if crate::os::OsClock::new()
+            .now_mono()
+            .saturating_duration_since(started)
+            >= Duration::from_secs(3600)
+        {
+            break;
+        }
+        if stop.load(Ordering::Acquire) {
+            break;
+        }
+        let mut request = [0u8; 25];
+        exact_for(
+            &mut stream,
+            &mut request[..1],
+            stop,
+            Duration::from_secs(300),
+        )?;
+        exact(&mut stream, &mut request[1..], stop)?;
+        let capability: [u8; 16] = request[1..17].try_into().map_err(std::io::Error::other)?;
+        let answer = match request[0] {
+            #[cfg(target_os = "windows")]
+            b'I' if request[17..] == [0; 8] && source.is_none() => {
+                let mut producer = [0; 8];
+                exact(&mut stream, &mut producer, stop)?;
+                let producer =
+                    u32::try_from(u64::from_le_bytes(producer)).map_err(std::io::Error::other)?;
+                let mut bytes = [0u8; 72];
+                exact(&mut stream, &mut bytes, stop)?;
+                let word = |at: usize| -> std::io::Result<u32> {
+                    Ok(u32::from_le_bytes(
+                        bytes[at..at + 4]
+                            .try_into()
+                            .map_err(std::io::Error::other)?,
+                    ))
+                };
+                let wide = |at: usize| -> std::io::Result<u64> {
+                    Ok(u64::from_le_bytes(
+                        bytes[at..at + 8]
+                            .try_into()
+                            .map_err(std::io::Error::other)?,
+                    ))
+                };
+                let descriptor = crate::video_sources::Descriptor {
+                    uuid: bytes[..16].try_into().map_err(std::io::Error::other)?,
+                    memory: isize::try_from(wide(16)?).unwrap_or(0),
+                    ready: isize::try_from(wide(24)?).unwrap_or(0),
+                    released: isize::try_from(wide(32)?).unwrap_or(0),
+                    allocation_size: wide(40)?,
+                    width: word(48)?,
+                    height: word(52)?,
+                    stride: word(56)?,
+                    memory_type: word(60)?,
+                    usage: word(64)?,
+                    reserved: word(68)?,
+                };
+                let opened = crate::video_sources::Source::from_process(producer, descriptor);
+                match opened {
+                    Ok(opened) => {
+                        source = Some(opened);
+                        0
+                    }
+                    Err(_) => 1,
+                }
+            }
+            #[cfg(target_os = "windows")]
+            b'C' => {
+                let generation =
+                    u64::from_le_bytes(request[17..25].try_into().map_err(std::io::Error::other)?);
+                match source.as_mut() {
+                    Some(source) => {
+                        if source.copy_to(capability, generation).is_ok() {
+                            0
+                        } else {
+                            1
+                        }
+                    }
+                    _ => 1,
+                }
+            }
+            b'A' => {
+                let width =
+                    u32::from_le_bytes(request[17..21].try_into().map_err(std::io::Error::other)?);
+                let height =
+                    u32::from_le_bytes(request[21..25].try_into().map_err(std::io::Error::other)?);
+                if video_targets::arm(capability, width, height).is_ok() {
+                    reservations.0.insert(capability);
+                    0u32
+                } else {
+                    1
+                }
+            }
+            b'Q' if request[17..] == [0; 8] => video_targets::state(capability),
+            b'D' if request[17..] == [0; 8] => {
+                video_targets::disarm(capability);
+                reservations.0.remove(&capability);
+                0
+            }
+            _ => u32::MAX,
+        };
+        stream.write_all(&answer.to_le_bytes())?;
+    }
+    Ok(())
+}
+
+fn exact(stream: &mut TcpStream, bytes: &mut [u8], stop: &AtomicBool) -> std::io::Result<()> {
+    exact_for(stream, bytes, stop, Duration::from_secs(3))
+}
+
+fn exact_for(
+    stream: &mut TcpStream,
+    mut bytes: &mut [u8],
+    stop: &AtomicBool,
+    duration: Duration,
+) -> std::io::Result<()> {
+    let deadline = crate::os::OsClock::new()
+        .now_mono()
+        .saturating_add(duration);
+    while !bytes.is_empty() {
+        if stop.load(Ordering::Acquire) {
+            return Err(std::io::ErrorKind::Interrupted.into());
+        }
+        let now = crate::os::OsClock::new().now_mono();
+        if now >= deadline {
+            return Err(std::io::ErrorKind::TimedOut.into());
+        }
+        stream.set_read_timeout(Some(
+            deadline
+                .saturating_duration_since(now)
+                .min(Duration::from_millis(100)),
+        ))?;
+        match stream.read(bytes) {
+            Ok(0) => return Err(std::io::ErrorKind::UnexpectedEof.into()),
+            Ok(count) => bytes = &mut bytes[count..],
+            Err(error)
+                if matches!(
+                    error.kind(),
+                    std::io::ErrorKind::WouldBlock
+                        | std::io::ErrorKind::TimedOut
+                        | std::io::ErrorKind::Interrupted
+                ) => {}
+            Err(error) => return Err(error),
+        }
+    }
+    Ok(())
+}
