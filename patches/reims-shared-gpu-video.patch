@@ -0,0 +1,569 @@
+//! Windows GPU-frame imports for explicitly armed NV12 targets. The frame
+//! remains in device-local memory until GPU blits reach the destination planes
+//! and the guest's coherent backing. No CPU pixel mapping or network payload is
+//! used here. The latter backing update is GPU DMA into guest RAM, not a claim
+//! that every consumer's pixels stay exclusively in VRAM.
+
+use std::sync::LazyLock;
+use std::sync::atomic::{AtomicBool, AtomicUsize, Ordering};
+use std::time::Duration;
+
+use ash::vk;
+use metal2vulkan_runtime as rt;
+use reims_vgpu_core::platform::Handle as _;
+use reims_vgpu_core::sync::Mutex;
+
+use crate::gpu::device::VulkanDevice;
+use crate::video_targets::{self, Capability};
+
+/// Metadata supplied by the trusted host producer. Handles are already
+/// duplicated into this process and ownership is passed to `Source::open`.
+pub struct Descriptor {
+    /// The producer's CUDA/Vulkan physical-device UUID.
+    pub uuid: [u8; 16],
+    /// Dedicated OPAQUE_WIN32 device-memory handle.
+    pub memory: isize,
+    /// Producer-ready timeline semaphore handle.
+    pub ready: isize,
+    /// Consumer-completed timeline semaphore handle.
+    pub released: isize,
+    /// The exporting allocation's exact byte size.
+    pub allocation_size: u64,
+    /// Luma width.
+    pub width: u32,
+    /// Luma height.
+    pub height: u32,
+    /// Row stride shared by Y and UV, aligned to 256 bytes.
+    pub stride: u32,
+    /// Exporting memory type, on the same physical device.
+    pub memory_type: u32,
+    /// Exact buffer usage of the exported buffer.
+    pub usage: u32,
+    /// Zero in the fixed source-descriptor protocol.
+    pub reserved: u32,
+}
+
+#[link(name = "kernel32")]
+unsafe extern "system" {
+    fn CloseHandle(handle: isize) -> i32;
+    fn OpenProcess(access: u32, inherit: i32, pid: u32) -> isize;
+    fn GetCurrentProcess() -> *mut std::ffi::c_void;
+    fn DuplicateHandle(
+        source: isize,
+        original: isize,
+        target: isize,
+        duplicate: *mut isize,
+        access: u32,
+        inherit: i32,
+        options: u32,
+    ) -> i32;
+}
+
+struct Handles([isize; 3]);
+impl Drop for Handles {
+    fn drop(&mut self) {
+        for handle in self.0 {
+            // SAFETY: the trusted producer supplied owned, process-local handles.
+            if handle != 0 {
+                unsafe { CloseHandle(handle) };
+            }
+        }
+    }
+}
+
+static ACTIVE: AtomicUsize = AtomicUsize::new(0);
+static FAILED: AtomicBool = AtomicBool::new(false);
+struct Slot;
+impl Drop for Slot {
+    fn drop(&mut self) {
+        ACTIVE.fetch_sub(1, Ordering::AcqRel);
+    }
+}
+struct Retained {
+    _gpu: VulkanDevice,
+    _queue: rt::CommandQueue,
+    _wrapped: Option<rt::Buffer>,
+    _slot: Slot,
+}
+// At most two sources can exist. After any in-flight failure new imports are
+// refused until process restart. GPU objects that might still be referenced
+// are kept with their device, never destroyed under a pending GPU command.
+static RETAINED: LazyLock<Mutex<Vec<Retained>>> = LazyLock::new(|| Mutex::new(Vec::new()));
+
+/// One imported GPU frame slot, reused only after the matching completion
+/// timeline value. A source belongs to one authenticated host connection.
+pub struct Source {
+    slot: Option<Slot>,
+    in_flight: bool,
+    gpu: VulkanDevice,
+    raw: ash::Device,
+    queue: rt::CommandQueue,
+    wrapped: Option<rt::Buffer>,
+    buffer: vk::Buffer,
+    memory: vk::DeviceMemory,
+    ready: vk::Semaphore,
+    released: vk::Semaphore,
+    pool: vk::CommandPool,
+    acquire: vk::CommandBuffer,
+    release: vk::CommandBuffer,
+    fence: vk::Fence,
+    family: u32,
+    width: u32,
+    height: u32,
+    stride: u32,
+    generation: u64,
+}
+
+fn check(result: Result<(), vk::Result>) -> Result<(), String> {
+    result.map_err(|error| format!("video GPU Vulkan error {error:?}"))
+}
+
+impl Source {
+    /// Duplicate producer-owned handles inside the consumer process. An
+    /// interrupted metadata request cannot leak remotely duplicated handles:
+    /// no duplication occurs until the entire descriptor has arrived here.
+    /// The caller authenticates this host producer; the guest supplies neither
+    /// its PID nor these handles.
+    pub fn from_process(pid: u32, mut descriptor: Descriptor) -> Result<Self, String> {
+        if pid == 0 {
+            return Err("invalid video producer process".to_owned());
+        }
+        // SAFETY: Win32 owns the returned process handle; Handles closes it.
+        let process = unsafe { OpenProcess(0x40, 0, pid) };
+        if process == 0 {
+            return Err("video producer process unavailable".to_owned());
+        }
+        let _process = Handles([process, 0, 0]);
+        let mut duplicated = Handles([0; 3]);
+        for (index, original) in [descriptor.memory, descriptor.ready, descriptor.released]
+            .into_iter()
+            .enumerate()
+        {
+            // SAFETY: only duplicate-handle access is requested, and output
+            // slots are local writable storage. No producer handle is closed.
+            if unsafe {
+                DuplicateHandle(
+                    process,
+                    original,
+                    GetCurrentProcess() as isize,
+                    &mut duplicated.0[index],
+                    0,
+                    0,
+                    2,
+                )
+            } == 0
+            {
+                return Err("video producer GPU handle unavailable".to_owned());
+            }
+        }
+        descriptor.memory = duplicated.0[0];
+        descriptor.ready = duplicated.0[1];
+        descriptor.released = duplicated.0[2];
+        duplicated.0 = [0; 3];
+        // SAFETY: these are now owned handles of this process, consumed even
+        // when import validation fails.
+        unsafe { Self::open(descriptor) }
+    }
+
+    /// Import a producer's dedicated allocation and timeline semaphores. No
+    /// CPU pixel access occurs. Refuses another GPU, sizes/usages outside the
+    /// protocol, or a device whose raw queue families cannot be shared here.
+    ///
+    /// # Safety
+    /// The three handles are valid owned GPU objects of this process, duplicated
+    /// from the matching producer. This consumes them, including on failure.
+    pub unsafe fn open(descriptor: Descriptor) -> Result<Self, String> {
+        let _handles = Handles([descriptor.memory, descriptor.ready, descriptor.released]);
+        if FAILED.load(Ordering::Acquire) {
+            return Err("video GPU imports disabled after a GPU failure".to_owned());
+        }
+        if ACTIVE.fetch_add(1, Ordering::AcqRel) >= 2 {
+            ACTIVE.fetch_sub(1, Ordering::AcqRel);
+            return Err("video GPU source limit".to_owned());
+        }
+        let slot = Slot;
+        if descriptor.reserved != 0
+            || !(16..=3840).contains(&descriptor.width)
+            || !(16..=2160).contains(&descriptor.height)
+            || descriptor.width & 1 != 0
+            || descriptor.height & 1 != 0
+            || descriptor.stride < descriptor.width
+            || descriptor.stride > 4096
+            || descriptor.stride & 255 != 0
+            || descriptor.memory == 0
+            || descriptor.ready == 0
+            || descriptor.released == 0
+        {
+            return Err("invalid video GPU source".to_owned());
+        }
+        let bytes = u64::from(descriptor.stride) * u64::from(descriptor.height) * 3 / 2;
+        if descriptor.allocation_size < bytes || descriptor.allocation_size > 64 * 1024 * 1024 {
+            return Err("video GPU allocation bound".to_owned());
+        }
+        let registry = crate::platform::default_device_registry_id()
+            .ok_or_else(|| "no video GPU".to_owned())?;
+        let gpu = crate::gpu::device::opened(registry)
+            .ok_or_else(|| "video GPU has not been opened".to_owned())?;
+        // SAFETY: the strong device handle remains in Source; no runtime-owned object is destroyed.
+        let handles = unsafe { gpu.raw.raw() };
+        let mut id = vk::PhysicalDeviceIDProperties::default();
+        let mut properties = vk::PhysicalDeviceProperties2::default().push_next(&mut id);
+        // SAFETY: live instance/physical device and writable property chain.
+        unsafe {
+            handles
+                .instance
+                .get_physical_device_properties2(handles.physical_device, &mut properties)
+        };
+        if id.device_uuid != descriptor.uuid || handles.queue_families.len() != 1 {
+            return Err("video GPU UUID or queue-family mismatch".to_owned());
+        }
+        let usage = vk::BufferUsageFlags::from_raw(descriptor.usage);
+        if usage.as_raw() != gpu.raw.vk_buffer_usage().as_raw() {
+            return Err("video GPU buffer usages differ".to_owned());
+        }
+        let queue = gpu
+            .raw
+            .new_command_queue_with_max_command_buffer_count(2)
+            .map_err(|e| e.to_string())?;
+        let mut source = Self {
+            slot: Some(slot),
+            in_flight: false,
+            raw: handles.device.clone(),
+            family: handles.queue_family,
+            gpu,
+            queue,
+            wrapped: None,
+            buffer: vk::Buffer::null(),
+            memory: vk::DeviceMemory::null(),
+            ready: vk::Semaphore::null(),
+            released: vk::Semaphore::null(),
+            pool: vk::CommandPool::null(),
+            acquire: vk::CommandBuffer::null(),
+            release: vk::CommandBuffer::null(),
+            fence: vk::Fence::null(),
+            width: descriptor.width,
+            height: descriptor.height,
+            stride: descriptor.stride,
+            generation: 0,
+        };
+        // SAFETY: all creation chains below describe this owned source's objects.
+        unsafe {
+            let mut external = vk::ExternalMemoryBufferCreateInfo::default()
+                .handle_types(vk::ExternalMemoryHandleTypeFlags::OPAQUE_WIN32);
+            let info = vk::BufferCreateInfo::default()
+                .size(bytes)
+                .usage(usage)
+                .push_next(&mut external);
+            source.buffer = source
+                .raw
+                .create_buffer(&info, None)
+                .map_err(|e| format!("video buffer {e:?}"))?;
+            let required = source.raw.get_buffer_memory_requirements(source.buffer);
+            let raw_handles = source.gpu.raw.raw();
+            let types = raw_handles
+                .instance
+                .get_physical_device_memory_properties(raw_handles.physical_device);
+            if descriptor.memory_type >= types.memory_type_count
+                || required.memory_type_bits & (1u32 << descriptor.memory_type) == 0
+                || !types.memory_types
+                    [usize::try_from(descriptor.memory_type).map_err(|_| "video memory type")?]
+                .property_flags
+                .contains(vk::MemoryPropertyFlags::DEVICE_LOCAL)
+                || descriptor.allocation_size < required.size
+            {
+                return Err("video GPU memory type or allocation mismatch".to_owned());
+            }
+            let mut import = vk::ImportMemoryWin32HandleInfoKHR::default()
+                .handle_type(vk::ExternalMemoryHandleTypeFlags::OPAQUE_WIN32)
+                .handle(descriptor.memory);
+            let mut dedicated = vk::MemoryDedicatedAllocateInfo::default().buffer(source.buffer);
+            let mut flags = vk::MemoryAllocateFlagsInfo::default()
+                .flags(vk::MemoryAllocateFlags::DEVICE_ADDRESS);
+            let allocate = vk::MemoryAllocateInfo::default()
+                .allocation_size(descriptor.allocation_size)
+                .memory_type_index(descriptor.memory_type)
+                .push_next(&mut import)
+                .push_next(&mut dedicated)
+                .push_next(&mut flags);
+            source.memory = source
+                .raw
+                .allocate_memory(&allocate, None)
+                .map_err(|e| format!("video GPU memory import {e:?}"))?;
+            check(
+                source
+                    .raw
+                    .bind_buffer_memory(source.buffer, source.memory, 0),
+            )?;
+            let bound = rt::VkBufferMemory::new(source.memory, 0, descriptor.memory_type, None);
+            let options = rt::ResourceOptions::new(
+                rt::StorageMode::Private,
+                rt::CpuCacheMode::DefaultCache,
+                rt::HazardTrackingMode::Tracked,
+            );
+            source.wrapped = Some(
+                source
+                    .gpu
+                    .raw
+                    .new_buffer_with_vk_buffer(source.buffer, &info, bound, bytes, options)
+                    .map_err(|e| e.to_string())?,
+            );
+            let imports =
+                ash::khr::external_semaphore_win32::Device::new(raw_handles.instance, &source.raw);
+            for (handle, output) in [
+                (descriptor.ready, &mut source.ready),
+                (descriptor.released, &mut source.released),
+            ] {
+                let mut timeline = vk::SemaphoreTypeCreateInfo::default()
+                    .semaphore_type(vk::SemaphoreType::TIMELINE);
+                *output = source
+                    .raw
+                    .create_semaphore(
+                        &vk::SemaphoreCreateInfo::default().push_next(&mut timeline),
+                        None,
+                    )
+                    .map_err(|e| format!("video semaphore {e:?}"))?;
+                check(
+                    imports.import_semaphore_win32_handle(
+                        &vk::ImportSemaphoreWin32HandleInfoKHR::default()
+                            .semaphore(*output)
+                            .handle_type(vk::ExternalSemaphoreHandleTypeFlags::OPAQUE_WIN32)
+                            .handle(handle),
+                    ),
+                )?;
+            }
+            source.pool = source
+                .raw
+                .create_command_pool(
+                    &vk::CommandPoolCreateInfo::default().queue_family_index(source.family),
+                    None,
+                )
+                .map_err(|e| format!("video command pool {e:?}"))?;
+            let commands = source
+                .raw
+                .allocate_command_buffers(
+                    &vk::CommandBufferAllocateInfo::default()
+                        .command_pool(source.pool)
+                        .level(vk::CommandBufferLevel::PRIMARY)
+                        .command_buffer_count(2),
+                )
+                .map_err(|e| format!("video commands {e:?}"))?;
+            source.acquire = commands[0];
+            source.release = commands[1];
+            source.fence = source
+                .raw
+                .create_fence(&vk::FenceCreateInfo::default(), None)
+                .map_err(|e| format!("video fence {e:?}"))?;
+            for (command, from, to, src, dst) in [
+                (
+                    source.acquire,
+                    vk::QUEUE_FAMILY_EXTERNAL,
+                    source.family,
+                    vk::AccessFlags::empty(),
+                    vk::AccessFlags::TRANSFER_READ,
+                ),
+                (
+                    source.release,
+                    source.family,
+                    vk::QUEUE_FAMILY_EXTERNAL,
+                    vk::AccessFlags::TRANSFER_READ,
+                    vk::AccessFlags::empty(),
+                ),
+            ] {
+                check(
+                    source
+                        .raw
+                        .begin_command_buffer(command, &vk::CommandBufferBeginInfo::default()),
+                )?;
+                let barrier = vk::BufferMemoryBarrier::default()
+                    .src_queue_family_index(from)
+                    .dst_queue_family_index(to)
+                    .buffer(source.buffer)
+                    .size(vk::WHOLE_SIZE)
+                    .src_access_mask(src)
+                    .dst_access_mask(dst);
+                source.raw.cmd_pipeline_barrier(
+                    command,
+                    vk::PipelineStageFlags::ALL_COMMANDS,
+                    vk::PipelineStageFlags::ALL_COMMANDS,
+                    vk::DependencyFlags::empty(),
+                    &[],
+                    &[barrier],
+                    &[],
+                );
+                check(source.raw.end_command_buffer(command))?;
+            }
+        }
+        Ok(source)
+    }
+
+    /// Copy exactly one new producer generation into its armed target. Pixels
+    /// move through GPU commands. The coherent guest backing also receives a
+    /// GPU copy, so CPU consumers and later guest paging see correct pixels.
+    pub fn copy_to(&mut self, capability: Capability, generation: u64) -> Result<(), String> {
+        if self.generation.checked_add(1) != Some(generation) {
+            return Err("video GPU generation mismatch".to_owned());
+        }
+        video_targets::with_target(capability, |buffer, textures, layout| {
+            if layout.width != self.width
+                || layout.height != self.height
+                || buffer.device.registry_id != self.gpu.registry_id
+            {
+                return Err("video GPU target shape/device mismatch".to_owned());
+            }
+            let semaphore = [self.ready];
+            let values = [generation];
+            let wait = vk::SemaphoreWaitInfo::default()
+                .semaphores(&semaphore)
+                .values(&values);
+            // Check the timeline *before* queueing a GPU wait. A disconnected
+            // producer must time out without leaving the render queue stuck.
+            check(unsafe { self.raw.wait_semaphores(&wait, 20_000_000_000) })?;
+            self.in_flight = true;
+            self.transfer_ownership(self.acquire, Some(generation), None)?;
+            let command = self.queue.command_buffer().map_err(|e| e.to_string())?;
+            let mut blit = command.blit_command_encoder().map_err(|e| e.to_string())?;
+            let source = self
+                .wrapped
+                .as_ref()
+                .ok_or_else(|| "closed video GPU source".to_owned())?;
+            for (i, texture) in textures.iter().enumerate() {
+                let divisor = if i == 0 { 1 } else { 2 };
+                let size = rt::Size::new(
+                    u64::from(self.width / divisor),
+                    u64::from(self.height / divisor),
+                    1,
+                );
+                let offset = if i == 0 {
+                    0
+                } else {
+                    u64::from(self.stride) * u64::from(self.height)
+                };
+                blit.copy_from_buffer_to_texture(
+                    source,
+                    offset,
+                    u64::from(self.stride),
+                    0,
+                    size,
+                    &texture.raw,
+                    0,
+                    0,
+                    rt::Origin::new(0, 0, 0),
+                    rt::BlitOption::None,
+                )
+                .map_err(|e| e.to_string())?;
+                blit.copy_from_texture_to_buffer(
+                    &texture.raw,
+                    0,
+                    0,
+                    rt::Origin::new(0, 0, 0),
+                    size,
+                    &buffer.raw,
+                    layout.offsets[i],
+                    layout.strides[i],
+                    0,
+                    rt::BlitOption::None,
+                )
+                .map_err(|e| e.to_string())?;
+            }
+            blit.end_encoding().map_err(|e| e.to_string())?;
+            command.commit().map_err(|e| e.to_string())?;
+            command
+                .wait_until_completed_for(Duration::from_secs(20))
+                .map_err(|_| "video GPU target copy deadline".to_owned())?;
+            if command.status() != rt::CommandBufferStatus::Completed {
+                return Err("video GPU target command failed".to_owned());
+            }
+            self.transfer_ownership(self.release, None, Some(generation))?;
+            self.in_flight = false;
+            self.generation = generation;
+            Ok(())
+        })
+        .ok_or_else(|| "video GPU target is absent or released".to_owned())?
+    }
+
+    fn transfer_ownership(
+        &self,
+        command: vk::CommandBuffer,
+        wait: Option<u64>,
+        signal: Option<u64>,
+    ) -> Result<(), String> {
+        let waits = if wait.is_some() {
+            vec![self.ready]
+        } else {
+            Vec::new()
+        };
+        let signals = if signal.is_some() {
+            vec![self.released]
+        } else {
+            Vec::new()
+        };
+        let wait_values: Vec<_> = wait.into_iter().collect();
+        let signal_values: Vec<_> = signal.into_iter().collect();
+        let stages = vec![vk::PipelineStageFlags::ALL_COMMANDS; waits.len()];
+        let commands = [command];
+        let mut timeline = vk::TimelineSemaphoreSubmitInfo::default()
+            .wait_semaphore_values(&wait_values)
+            .signal_semaphore_values(&signal_values);
+        let info = vk::SubmitInfo::default()
+            .wait_semaphores(&waits)
+            .wait_dst_stage_mask(&stages)
+            .command_buffers(&commands)
+            .signal_semaphores(&signals)
+            .push_next(&mut timeline);
+        check(unsafe { self.raw.reset_fences(&[self.fence]) })?;
+        // SAFETY: the runtime lends its queue under its own submission lock;
+        // this callback makes no runtime call or wait for a later submission.
+        let submitted = unsafe {
+            self.queue.with_vk_queue(|queue, family| {
+                if family != self.family {
+                    return Err("video queue family changed".to_owned());
+                }
+                check(self.raw.queue_submit(queue, &[info], self.fence))
+            })
+        };
+        submitted?;
+        check(unsafe {
+            self.raw
+                .wait_for_fences(&[self.fence], true, 20_000_000_000)
+        })
+    }
+}
+
+impl Drop for Source {
+    fn drop(&mut self) {
+        if self.in_flight {
+            FAILED.store(true, Ordering::Release);
+            if let Some(slot) = self.slot.take() {
+                RETAINED.lock().push(Retained {
+                    _gpu: self.gpu.clone_ref(),
+                    _queue: self.queue.clone(),
+                    _wrapped: self.wrapped.take(),
+                    _slot: slot,
+                });
+            }
+            return;
+        }
+        drop(self.wrapped.take());
+        // SAFETY: these objects belong only to this source and its completed commands.
+        unsafe {
+            if self.fence != vk::Fence::null() {
+                self.raw.destroy_fence(self.fence, None);
+            }
+            if self.pool != vk::CommandPool::null() {
+                self.raw.destroy_command_pool(self.pool, None);
+            }
+            if self.ready != vk::Semaphore::null() {
+                self.raw.destroy_semaphore(self.ready, None);
+            }
+            if self.released != vk::Semaphore::null() {
+                self.raw.destroy_semaphore(self.released, None);
+            }
+            if self.buffer != vk::Buffer::null() {
+                self.raw.destroy_buffer(self.buffer, None);
+            }
+            if self.memory != vk::DeviceMemory::null() {
+                self.raw.free_memory(self.memory, None);
+            }
+        }
+    }
+}
diff --git a/crates/reims-vgpu-vulkan/src/video_targets.rs b/crates/reims-vgpu-vulkan/src/video_targets.rs
new file mode 100644
index 0000000..f406486
--- /dev/null
+++ b/crates/reims-vgpu-vulkan/src/video_targets.rs
@@ -0,0 +1,389 @@
+//! Explicit host-armed video targets over guest IOSurface backings.
+//!
+//! No guest texture ID is required. An authored codec owns a separate metadata
+//! page before its two NV12 planes. A random capability in that page identifies
+//! only a target the host armed, for at most twenty seconds. Unarmed surfaces
+//! follow the ordinary path. This registry performs no video copy, changes no
+//! pixels. Only explicitly armed targets are retained until disarm or their
+//! twenty-second deadline; ordinary unarmed surfaces retain nothing here.
+
+use reims_vgpu_core::platform::os::{Clock as _, MonoTime};
+use std::collections::BTreeMap;
+use std::sync::LazyLock;
+use std::sync::atomic::{AtomicBool, AtomicU8, Ordering};
+use std::time::Duration;
+
+use reims_vgpu_core::platform::os::surface::BackingSurfaceSpec;
+use reims_vgpu_core::sync::Mutex;
+
+use crate::gpu::resource::{VulkanBuffer, VulkanTexture};
+use reims_vgpu_core::platform::Handle as _;
+
+/// The explicit metadata ABI marker, not an application or shader identity.
+pub const MAGIC: &[u8; 16] = b"NativeMacVideo01";
+/// The separate metadata page, never part of the video pixels.
+pub const HEADER_BYTES: u64 = 4096;
+/// Metadata is beyond CoreVideo's planar header, inside the alignment page.
+pub const METADATA_OFFSET: usize = 1024;
+/// NV12, video range, eight-bit 4:2:0.
+pub const PIXEL_FORMAT: u32 = u32::from_be_bytes(*b"420v");
+const LIMIT: usize = 64;
+const DEADLINE: Duration = Duration::from_secs(20);
+
+/// A random host-issued resource capability. All-zero is refused.
+pub type Capability = [u8; 16];
+
+/// The validated layout of the two planes in the guest's shared buffer.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Layout {
+    /// Luma width in bytes and pixels.
+    pub width: u32,
+    /// Luma height in rows.
+    pub height: u32,
+    /// Y then UV byte offsets, both past the metadata page.
+    pub offsets: [u64; 2],
+    /// Y then UV bytes per row.
+    pub strides: [u64; 2],
+}
+
+struct Slot {
+    width: u32,
+    height: u32,
+    armed: MonoTime,
+    target: Option<Target>,
+}
+
+struct Target {
+    buffer: VulkanBuffer,
+    textures: [VulkanTexture; 2],
+    layout: Layout,
+}
+
+static ENABLED: AtomicBool = AtomicBool::new(false);
+static GPU_IMPORTS: AtomicU8 = AtomicU8::new(0);
+static TARGETS: LazyLock<Mutex<BTreeMap<Capability, Slot>>> =
+    LazyLock::new(|| Mutex::new(BTreeMap::new()));
+
+/// Explicitly request Windows GPU import extensions before the process first
+/// creates a device. A request after options were frozen is refused.
+pub fn enable_gpu_imports() -> bool {
+    GPU_IMPORTS
+        .fetch_update(Ordering::AcqRel, Ordering::Acquire, |state| {
+            (state < 2).then_some(1)
+        })
+        .is_ok()
+}
+
+/// Freezes the one process-wide selection as device options are constructed.
+#[cfg(target_os = "windows")]
+pub(crate) fn take_gpu_imports() -> bool {
+    let state = GPU_IMPORTS
+        .fetch_update(Ordering::AcqRel, Ordering::Acquire, |state| {
+            Some(if state < 2 { state + 2 } else { state })
+        })
+        .unwrap_or_else(|state| state);
+    state == 1 || state == 3
+}
+
+/// Why the host's target reservation was refused.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Refusal {
+    /// A zero capability, odd/out-of-bounds dimensions or capability reuse.
+    Invalid,
+    /// All bounded slots are live or awaiting their initial binding.
+    Full,
+}
+
+/// Arms one exact NV12 target before the guest creates its backing. No Metal
+/// counterpart: this is an explicit host integration, not a device capability.
+/// The caller supplies a fresh unpredictable capability and keeps it private.
+pub fn arm(capability: Capability, width: u32, height: u32) -> Result<(), Refusal> {
+    if capability == [0; 16]
+        || !(16..=3840).contains(&width)
+        || !(16..=2160).contains(&height)
+        || !width.is_multiple_of(2)
+        || !height.is_multiple_of(2)
+    {
+        return Err(Refusal::Invalid);
+    }
+    reap_expired();
+    let mut slots = TARGETS.lock();
+    if slots.contains_key(&capability) {
+        return Err(Refusal::Invalid);
+    }
+    if slots.len() >= LIMIT {
+        return Err(Refusal::Full);
+    }
+    slots.insert(
+        capability,
+        Slot {
+            width,
+            height,
+            armed: crate::os::OsClock::new().now_mono(),
+            target: None,
+        },
+    );
+    ENABLED.store(true, Ordering::Release);
+    Ok(())
+}
+
+/// Removes the host reservation and releases its explicit GPU target hold.
+pub fn disarm(capability: Capability) {
+    let removed = { TARGETS.lock().remove(&capability) };
+    drop(removed);
+}
+
+/// A host query: 0 absent/expired, 1 awaiting binding, 2 bound to live objects.
+pub fn state(capability: Capability) -> u32 {
+    reap_expired();
+    let slots = TARGETS.lock();
+    slots
+        .get(&capability)
+        .map_or(0, |slot| if slot.target.is_some() { 2 } else { 1 })
+}
+
+/// Runs a host operation while strong references keep a bound buffer and its
+/// planes alive. The registry lock is not held across the operation. No pixels
+/// are read or written by this function. `None` means absent or released.
+pub fn with_target<R>(
+    capability: Capability,
+    run: impl FnOnce(&VulkanBuffer, &[VulkanTexture; 2], Layout) -> R,
+) -> Option<R> {
+    reap_expired();
+    let (buffer, textures, layout) = {
+        let slots = TARGETS.lock();
+        let target = slots.get(&capability)?.target.as_ref()?;
+        let buffer = target.buffer.clone_ref();
+        let textures = [
+            target.textures[0].clone_ref(),
+            target.textures[1].clone_ref(),
+        ];
+        (buffer, textures, target.layout)
+    };
+    Some(run(&buffer, &textures, layout))
+}
+
+fn take_expired(slots: &mut BTreeMap<Capability, Slot>, now: MonoTime) -> Vec<Slot> {
+    let keys: Vec<_> = slots
+        .iter()
+        .filter(|(_, slot)| now.saturating_duration_since(slot.armed) >= DEADLINE)
+        .map(|(key, _)| *key)
+        .collect();
+    keys.into_iter()
+        .filter_map(|key| slots.remove(&key))
+        .collect()
+}
+
+/// Reap the explicit GPU holds after their deadline. Removed objects are
+/// dropped outside the registry lock: GPU deallocators may take other locks.
+/// The owned endpoint calls this on its bounded listener loop even when idle.
+pub(crate) fn reap_expired() {
+    if !ENABLED.load(Ordering::Acquire) {
+        return;
+    }
+    let removed = {
+        let mut slots = TARGETS.lock();
+        take_expired(&mut slots, crate::os::OsClock::new().now_mono())
+    };
+    drop(removed);
+}
+
+fn describe(
+    bytes: &[u8; 64],
+    spec: &BackingSurfaceSpec,
+    length: u64,
+) -> Option<(Capability, Layout)> {
+    if &bytes[..16] != MAGIC
+        || u32::from_le_bytes(bytes[32..36].try_into().ok()?) != 1
+        || bytes[48..] != [0; 16]
+        || spec.pixel_format != PIXEL_FORMAT
+        || spec.planes.len() != 2
+    {
+        return None;
+    }
+    let capability: Capability = bytes[16..32].try_into().ok()?;
+    let width = u32::from_le_bytes(bytes[36..40].try_into().ok()?);
+    let height = u32::from_le_bytes(bytes[40..44].try_into().ok()?);
+    if capability == [0; 16]
+        || width != spec.width
+        || height != spec.height
+        || u32::from_le_bytes(bytes[44..48].try_into().ok()?) != PIXEL_FORMAT
+    {
+        return None;
+    }
+    let mut offsets = [0; 2];
+    let mut strides = [0; 2];
+    let mut end = HEADER_BYTES;
+    for (i, plane) in spec.planes.iter().enumerate() {
+        let divisor = if i == 0 { 1 } else { 2 };
+        if plane.width != width / divisor
+            || plane.height != height / divisor
+            || plane.bytes_per_element != i32::try_from(divisor).ok()?
+            || plane.bytes_per_row < i32::try_from(width).ok()?
+        {
+            return None;
+        }
+        let offset = u64::from(plane.offset);
+        let stride = u64::try_from(plane.bytes_per_row).ok()?;
+        let stop = offset.checked_add(stride.checked_mul(u64::from(plane.height))?)?;
+        if offset < end || stop > length {
+            return None;
+        }
+        offsets[i] = offset;
+        strides[i] = stride;
+        end = stop;
+    }
+    Some((
+        capability,
+        Layout {
+            width,
+            height,
+            offsets,
+            strides,
+        },
+    ))
+}
+
+/// The optional core notification: inspect only the fixed metadata header of
+/// an exact two-plane NV12 backing. No pixel bytes are accessed or copied.
+pub(crate) fn observe(
+    buffer: &VulkanBuffer,
+    textures: &[VulkanTexture],
+    spec: &BackingSurfaceSpec,
+) {
+    if !ENABLED.load(Ordering::Acquire) || textures.len() != 2 || spec.pixel_format != PIXEL_FORMAT
+    {
+        return;
+    }
+    let length = buffer.raw.length();
+    if length < HEADER_BYTES {
+        return;
+    }
+    let Some(pointer) = buffer.raw.contents() else {
+        return;
+    };
+    let mut bytes = [0u8; 64];
+    for (i, byte) in bytes.iter_mut().enumerate() {
+        // SAFETY: the retained shared buffer covers the header. Guest writes
+        // may race it, so snapshot volatile bytes and validate the whole ABI.
+        *byte = unsafe { pointer.as_ptr().add(METADATA_OFFSET + i).read_volatile() };
+    }
+    let Some((capability, layout)) = describe(&bytes, spec, length) else {
+        return;
+    };
+    reap_expired();
+    let mut slots = TARGETS.lock();
+    let Some(slot) = slots.get_mut(&capability) else {
+        return;
+    };
+    if slot.width != layout.width || slot.height != layout.height || slot.target.is_some() {
+        return;
+    }
+    slot.target = Some(Target {
+        buffer: buffer.clone_ref(),
+        textures: [textures[0].clone_ref(), textures[1].clone_ref()],
+        layout,
+    });
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use reims_vgpu_core::platform::os::surface::BackingPlaneSpec;
+
+    fn fixture() -> ([u8; 64], BackingSurfaceSpec, u64) {
+        let mut header = [0; 64];
+        header[..16].copy_from_slice(MAGIC);
+        header[16..32].fill(7);
+        for (offset, value) in [(32, 1u32), (36, 320), (40, 180), (44, PIXEL_FORMAT)] {
+            header[offset..offset + 4].copy_from_slice(&value.to_le_bytes());
+        }
+        let planes = [(320, 180, 1, 4096), (160, 90, 2, 61696)]
+            .into_iter()
+            .map(|(width, height, bpe, offset)| BackingPlaneSpec {
+                width,
+                height,
+                bytes_per_element: bpe,
+                bytes_per_row: 320,
+                base: offset,
+                offset,
+            })
+            .collect();
+        (
+            header,
+            BackingSurfaceSpec {
+                pixel_format: PIXEL_FORMAT,
+                planes,
+                width: 320,
+                height: 180,
+            },
+            90496,
+        )
+    }
+
+    #[test]
+    fn exact_header_and_disjoint_planes_describe_the_target() {
+        let (header, spec, length) = fixture();
+        let (capability, layout) = describe(&header, &spec, length).unwrap();
+        assert_eq!(capability, [7; 16]);
+        assert_eq!(layout.offsets, [4096, 61696]);
+        assert_eq!(layout.strides, [320, 320]);
+    }
+
+    #[test]
+    fn wrong_header_dimensions_and_unknown_version_are_refused() {
+        let (mut header, spec, length) = fixture();
+        header[36..40].copy_from_slice(&318u32.to_le_bytes());
+        assert!(describe(&header, &spec, length).is_none());
+        header[36..40].copy_from_slice(&320u32.to_le_bytes());
+        header[32] = 2;
+        assert!(describe(&header, &spec, length).is_none());
+    }
+
+    #[test]
+    fn pixel_overlap_short_stride_and_out_of_buffer_planes_are_refused() {
+        let (header, mut spec, length) = fixture();
+        spec.planes[0].offset = 0;
+        assert!(describe(&header, &spec, length).is_none());
+        spec.planes[0].offset = 4096;
+        spec.planes[1].offset = 61695;
+        assert!(describe(&header, &spec, length).is_none());
+        spec.planes[1].offset = 61696;
+        spec.planes[1].bytes_per_row = 319;
+        assert!(describe(&header, &spec, length).is_none());
+        spec.planes[1].bytes_per_row = 320;
+        assert!(describe(&header, &spec, length - 1).is_none());
+    }
+
+    #[test]
+    fn absent_target_never_calls_the_operation() {
+        assert_eq!(
+            with_target([0; 16], |_, _, _| panic!("unarmed target")),
+            None::<()>
+        );
+        assert_eq!(arm([0; 16], 320, 180), Err(Refusal::Invalid));
+        assert_eq!(arm([1; 16], 319, 180), Err(Refusal::Invalid));
+    }
+
+    #[test]
+    fn reservations_expire_at_the_exact_monotonic_deadline() {
+        let mut slots = BTreeMap::new();
+        let start = MonoTime::from_nanos(1_000);
+        slots.insert(
+            [9; 16],
+            Slot {
+                width: 320,
+                height: 180,
+                armed: start,
+                target: None,
+            },
+        );
+        assert!(take_expired(&mut slots, start.saturating_add(Duration::from_secs(19))).is_empty());
+        assert_eq!(slots.len(), 1);
+        assert_eq!(
+            take_expired(&mut slots, start.saturating_add(DEADLINE)).len(),
+            1
+        );
+        assert!(slots.is_empty());
+    }
+}
