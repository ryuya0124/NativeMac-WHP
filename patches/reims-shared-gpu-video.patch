@@ -0,0 +1,274 @@
+//! Explicit host-issued capabilities for authored video IOSurface targets.
+//! These notifications alone copy no media. Windows Vulkan integration only;
+//! every other platform answers `RVG_ERR_UNSUPPORTED`.
+
+use crate::ffi;
+use crate::sized::{self, HostStruct};
+#[cfg(target_os = "windows")]
+use crate::status::RVG_OK;
+use crate::status::{RVG_ERR_INVALID_ARGUMENT, RVG_ERR_UNSUPPORTED, RvgStatus};
+
+/// Version 1 of one host-issued NV12 target reservation. No guest pointers or
+/// host handles cross this interface. The caller supplies a fresh random
+/// capability and keeps it private until given to its own codec client.
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct RvgVideoTargetConfig {
+    /// `sizeof(RvgVideoTargetConfig)`; starts every host-written config.
+    pub struct_size: u32,
+    /// Even luma width, 16 through 3840.
+    pub width: u32,
+    /// Even luma height, 16 through 2160.
+    pub height: u32,
+    /// Zero in version 1.
+    pub reserved: u32,
+    /// Fresh nonzero 128-bit resource capability.
+    pub capability: [u8; 16],
+}
+
+// SAFETY: repr(C), a u32 first, integer fields only.
+unsafe impl HostStruct for RvgVideoTargetConfig {}
+
+/// Configuration of the optional host loopback metadata endpoint. No guest
+/// media is carried. The host alone keeps this separate authentication key.
+#[repr(C)]
+#[derive(Clone, Copy)]
+pub struct RvgVideoEndpointConfig {
+    /// `sizeof(RvgVideoEndpointConfig)`.
+    pub struct_size: u32,
+    /// Explicit loopback TCP port, 1024 through 65535.
+    pub port: u32,
+    /// Zero in version 1.
+    pub reserved: u32,
+    /// A random nonzero 256-bit host-only key.
+    pub secret: [u8; 32],
+}
+
+// SAFETY: repr(C), a u32 first, integer fields only.
+unsafe impl HostStruct for RvgVideoEndpointConfig {}
+
+/// Request the Windows Vulkan external-memory/semaphore extensions before
+/// the first device is created. A late request answers UNSUPPORTED. This is
+/// opt-in and changes no extension selection in the default path.
+#[unsafe(no_mangle)]
+pub extern "C" fn rvg_video_gpu_import_enable() -> RvgStatus {
+    ffi::export(|| {
+        #[cfg(target_os = "windows")]
+        {
+            if reims_vgpu_vulkan::video_targets::enable_gpu_imports() {
+                RVG_OK
+            } else {
+                RVG_ERR_UNSUPPORTED
+            }
+        }
+        #[cfg(not(target_os = "windows"))]
+        {
+            RVG_ERR_UNSUPPORTED
+        }
+    })
+}
+
+/// One owned metadata endpoint. Release it before unloading the library.
+pub struct RvgVideoEndpoint {
+    #[cfg(target_os = "windows")]
+    _inner: reims_vgpu_vulkan::video_endpoint::Endpoint,
+}
+
+/// Start the explicitly configured Windows-only loopback metadata endpoint.
+/// NULL outputs/configs and invalid fields are refused; bind failure returns
+/// UNSUPPORTED. Writes an owned handle only on success. No pixels are copied.
+///
+/// # Safety
+/// The config is NULL or readable for its `struct_size`, and `out` is NULL or
+/// points at one writable handle slot. Neither pointer is retained.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_video_endpoint_create(
+    config: *const RvgVideoEndpointConfig,
+    out: *mut *mut RvgVideoEndpoint,
+) -> RvgStatus {
+    ffi::export(|| {
+        if out.is_null() {
+            return RVG_ERR_INVALID_ARGUMENT;
+        }
+        // SAFETY: the caller lends the configuration.
+        let config = match unsafe { sized::read(config) } {
+            Ok(Some(config))
+                if config.reserved == 0
+                    && (1024..=65535).contains(&config.port)
+                    && config.secret != [0; 32] =>
+            {
+                config
+            }
+            Ok(_) => return RVG_ERR_INVALID_ARGUMENT,
+            Err(status) => return status,
+        };
+        #[cfg(target_os = "windows")]
+        {
+            let Ok(port) = u16::try_from(config.port) else {
+                return RVG_ERR_INVALID_ARGUMENT;
+            };
+            let Ok(inner) = reims_vgpu_vulkan::video_endpoint::Endpoint::start(port, config.secret)
+            else {
+                return RVG_ERR_UNSUPPORTED;
+            };
+            let handle = crate::handle::new(RvgVideoEndpoint { _inner: inner });
+            // SAFETY: caller lends the writable output slot.
+            unsafe { out.write(handle) };
+            RVG_OK
+        }
+        #[cfg(not(target_os = "windows"))]
+        {
+            let _ = config;
+            RVG_ERR_UNSUPPORTED
+        }
+    })
+}
+
+/// Release one endpoint handle; NULL is ignored. The last release closes its
+/// listener. In-progress metadata requests finish within their I/O deadline.
+///
+/// # Safety
+/// `endpoint` is NULL or an owned live handle from this API, released once.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_video_endpoint_release(endpoint: *mut RvgVideoEndpoint) {
+    ffi::export(|| {
+        // SAFETY: the caller returns its owned handle once.
+        unsafe { crate::handle::release(endpoint) };
+    })
+}
+
+/// Arm an exact target with a twenty-second deadline. The endpoint reaps
+/// expired holds while idle; standalone users must disarm or poll state.
+/// At most 64 reservations/target holds exist. A duplicate capability or
+/// invalid config answers INVALID_ARGUMENT; exhaustion answers UNSUPPORTED.
+/// Only an explicitly armed target is retained until disarm or expiry.
+/// Unarmed surfaces are unaffected; no pixel is read or changed.
+///
+/// # Safety
+/// `config` is NULL or points at `struct_size` readable bytes beginning with
+/// this configuration. No function retains its pointer.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_video_target_arm(config: *const RvgVideoTargetConfig) -> RvgStatus {
+    ffi::export(|| {
+        // SAFETY: caller's configuration contract.
+        let config = match unsafe { sized::read(config) } {
+            Ok(Some(config)) if config.reserved == 0 => config,
+            Ok(_) => return RVG_ERR_INVALID_ARGUMENT,
+            Err(status) => return status,
+        };
+        #[cfg(target_os = "windows")]
+        {
+            use reims_vgpu_vulkan::video_targets::{self, Refusal};
+            match video_targets::arm(config.capability, config.width, config.height) {
+                Ok(()) => RVG_OK,
+                Err(Refusal::Invalid) => RVG_ERR_INVALID_ARGUMENT,
+                Err(Refusal::Full) => RVG_ERR_UNSUPPORTED,
+            }
+        }
+        #[cfg(not(target_os = "windows"))]
+        {
+            let _ = config;
+            RVG_ERR_UNSUPPORTED
+        }
+    })
+}
+
+/// Query one exact capability. On success, writes 0 for absent/expired, 1 for
+/// waiting, or 2 for bound to live objects. A zero capability cannot bind.
+///
+/// # Safety
+/// `capability` points at 16 readable bytes; `state` points at a writable u32.
+/// NULL pointers are refused. No pointer is retained.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_video_target_state(
+    capability: *const u8,
+    state: *mut u32,
+) -> RvgStatus {
+    ffi::export(|| {
+        if capability.is_null() || state.is_null() {
+            return RVG_ERR_INVALID_ARGUMENT;
+        }
+        #[cfg(target_os = "windows")]
+        {
+            // SAFETY: the caller lends 16 readable capability bytes and the output.
+            let capability = unsafe { capability.cast::<[u8; 16]>().read_unaligned() };
+            let value = reims_vgpu_vulkan::video_targets::state(capability);
+            // SAFETY: the caller lends the writable output.
+            unsafe { state.write(value) };
+            RVG_OK
+        }
+        #[cfg(not(target_os = "windows"))]
+        {
+            RVG_ERR_UNSUPPORTED
+        }
+    })
+}
+
+/// Remove the reservation and its explicit GPU target hold. Does not wait for
+/// an operation that already obtained its own strong references.
+///
+/// # Safety
+/// `capability` is NULL or points at 16 readable bytes, retained by no function.
+#[unsafe(no_mangle)]
+pub unsafe extern "C" fn rvg_video_target_disarm(capability: *const u8) -> RvgStatus {
+    ffi::export(|| {
+        if capability.is_null() {
+            return RVG_ERR_INVALID_ARGUMENT;
+        }
+        #[cfg(target_os = "windows")]
+        {
+            // SAFETY: the caller lends 16 readable bytes.
+            let capability = unsafe { capability.cast::<[u8; 16]>().read_unaligned() };
+            reims_vgpu_vulkan::video_targets::disarm(capability);
+            RVG_OK
+        }
+        #[cfg(not(target_os = "windows"))]
+        {
+            RVG_ERR_UNSUPPORTED
+        }
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn video_configs_have_stable_sizes_and_invalid_inputs_leave_outputs_untouched() {
+        assert_eq!(size_of::<RvgVideoTargetConfig>(), 32);
+        assert_eq!(size_of::<RvgVideoEndpointConfig>(), 44);
+        let mut output = 0x1234usize as *mut RvgVideoEndpoint;
+        let config = RvgVideoEndpointConfig {
+            struct_size: 44,
+            port: 54888,
+            reserved: 0,
+            secret: [0; 32],
+        };
+        // SAFETY: all nonnull inputs/outputs are valid local storage. Invalid
+        // configurations must be rejected without retaining or dereferencing
+        // the sentinel endpoint value in the output slot.
+        unsafe {
+            assert_eq!(
+                rvg_video_endpoint_create(std::ptr::null(), &mut output),
+                RVG_ERR_INVALID_ARGUMENT
+            );
+            assert_eq!(
+                rvg_video_endpoint_create(&config, &mut output),
+                RVG_ERR_INVALID_ARGUMENT
+            );
+            assert_eq!(output as usize, 0x1234);
+            assert_eq!(
+                rvg_video_target_arm(std::ptr::null()),
+                RVG_ERR_INVALID_ARGUMENT
+            );
+            assert_eq!(
+                rvg_video_target_disarm(std::ptr::null()),
+                RVG_ERR_INVALID_ARGUMENT
+            );
+            assert_eq!(
+                rvg_video_target_state(std::ptr::null(), std::ptr::null_mut()),
+                RVG_ERR_INVALID_ARGUMENT
+            );
+        }
+    }
+}
