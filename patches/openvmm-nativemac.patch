+mod tests {
+    use super::*;
+    use crate::mapping_manager::MappingManager;
+    use crate::region_manager::RegionManager;
+
+    #[test]
+    fn unmapped_device_ranges_can_be_mapped_again() {
+        let (_thread, driver) = pal_async::DefaultPool::spawn_on_thread("device-remap-test");
+        let mappings = MappingManager::new_without_primary(&driver, 0x100000, None);
+        let regions = RegionManager::new(&driver, mappings.client().clone());
+        let mapper = DeviceMemoryMapper { region_manager: regions.client().clone() };
+        let (mut control, region) = mapper.new_region(0x10000, "test".into()).unwrap();
+        let section = sparse_mmap::alloc_shared_memory(0x20000, "test").unwrap();
+        region.map(0, &section, 0, 0x1000, true).unwrap();
+        region.map(0x2000, &section, 0x2000, 0x1000, true).unwrap();
+        // Removing the first range must preserve the second, and make the
+        // first available for a new backing after a display mode change.
+        region.unmap(0, 0x1000).unwrap();
+        region.map(0, &section, 0x1000, 0x1000, true).unwrap();
+        control.map_to_guest(0x10000, true).unwrap();
+        region.unmap(0, 0x10000).unwrap();
+        region.map(0, &section, 0, 0x1000, true).unwrap();
+        control.unmap_from_guest();
+    }
+}
