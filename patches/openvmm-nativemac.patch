+        while i<REPORT_DESCRIPTOR.len() {
+            let tag=REPORT_DESCRIPTOR[i]; i+=1;
+            let n=match tag&3 {3=>4,n=>n as usize};
+            let mut value=0u32;
+            for byte in 0..n {value|=u32::from(REPORT_DESCRIPTOR[i+byte])<<(byte*8);}
+            i+=n;
+            match tag&0xfc {
+                0x74=>size=value,0x94=>count=value,0x08=>usage=value,
+                0x80=>{if usage==0x38 && value&1==0 {wheel=Some((offset,size,count,value));} offset+=size*count;usage=0;},
+                _=>{}
+            }
+        }
+        assert_eq!(wheel,Some((40,8,1,6)));
+        assert_eq!(offset,56);
+        for notch in [-1i8,1] {
+            let report=MousePacket{button_data:HID_MOUSE_BUTTON_LEFT,x:0x1234,y:0x5678,z:notch,reserved:0};
+            assert_eq!(report.as_bytes(),&[1,0x34,0x12,0x78,0x56,notch as u8,0]);
