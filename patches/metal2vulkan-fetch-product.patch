+#[test]
+fn fast_half_target_product_fetch_compiles_in_both_device_policies() {
+    use crate::metal::{BlendFactor, ColorWriteMask};
+    let Some(fetch) = fixture("fragment_fetch") else {
+        return;
+    };
+    let path = Path::new(env!("CARGO_MANIFEST_DIR"))
+        .join("../metal2vulkan-validation/profiles/nvidia-rtx50-linux.json");
+    let description =
+        DeviceDescription::from_khronos_json(&std::fs::read_to_string(path).unwrap(), None)
+            .unwrap();
+    for policy in [
+        DevicePolicy::default(),
+        DevicePolicy::default().exact_answers(),
+    ] {
+        let device = Device::new(description.clone(), policy).unwrap();
+        for format in [
+            PixelFormat::R16Float,
+            PixelFormat::RG16Float,
+            PixelFormat::RGBA16Float,
+        ] {
+            for mask in [ColorWriteMask::ALL, ColorWriteMask::RED] {
+                let mut colors = [None; 8];
+                let mut color = ColorAttachmentDescriptor::new(format);
+                color.blending_enabled = true;
+                color.source_rgb_blend_factor = BlendFactor::DestinationColor;
+                color.destination_rgb_blend_factor = BlendFactor::Zero;
+                color.source_alpha_blend_factor = BlendFactor::DestinationAlpha;
+                color.destination_alpha_blend_factor = BlendFactor::Zero;
+                color.write_mask = mask;
+                colors[0] = Some(color);
+                let inputs = LoweringInputs {
+                    framebuffer_fetch: Some(FramebufferFetchInputs::of(
+                        [0],
+                        &colors,
+                        false,
+                        false,
+                        1,
+                    )),
+                    ..LoweringInputs::new()
+                };
+                let entry = if format == PixelFormat::R16Float {
+                    "fetch_scalar"
+                } else {
+                    "fetch_ordered"
+                };
+                let compiled = compile_with(&fetch, entry, device.profile(), &inputs)
+                    .unwrap_or_else(|e| panic!("{format:?} {mask:?}: {e}"));
+                link_and_validate(&compiled, device.profile()).unwrap();
+                assert!(compiled
+                    .precision
+                    .contains(&PrecisionNote::DeviceColorConversion));
+                assert!(compiled.facts.iter().any(|fact| matches!(
+                    fact,
+                    RuntimeFact::InterlockedFramebufferFetch {
+                        rounded: false,
+                        blend: Some(_),
+                        ..
+                    }
+                )));
+            }
+        }
+    }
+}
