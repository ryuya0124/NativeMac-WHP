diff --git a/crates/metal2vulkan/src/lower/fragment/fetch/product.rs b/crates/metal2vulkan/src/lower/fragment/fetch/product.rs
new file mode 100644
index 0000000..cabd5d5
--- /dev/null
+++ b/crates/metal2vulkan/src/lower/fragment/fetch/product.rs
@@ -0,0 +1,97 @@
+//! Fast-math source-times-destination on direct 16-bit float attachments.
+//!
+//! The ordered interlock reads the destination and stores one f32 product, with
+//! `DeviceColorConversion`. No term is clamped and no destination term is added.
+//! Rounded half arithmetic keeps its existing exact-policy path instead.
+
+use crate::lower::arith::extended_range::blend::BlendMath;
+use crate::lower::arith::{FloatFmt, Form};
+use crate::metal::{BlendFactor, BlendOperation};
+use crate::pipeline::lower_inputs::BlendEquation;
+use crate::vk;
+
+pub(super) fn accepts(format: vk::Format, eq: BlendEquation, math: BlendMath) -> bool {
+    math == BlendMath::Fast
+        && matches!(
+            format,
+            vk::Format::R16_SFLOAT | vk::Format::R16G16_SFLOAT | vk::Format::R16G16B16A16_SFLOAT
+        )
+        && eq.source_rgb == BlendFactor::DestinationColor
+        && eq.destination_rgb == BlendFactor::Zero
+        && eq.rgb_operation == BlendOperation::Add
+        && eq.source_alpha == BlendFactor::DestinationAlpha
+        && eq.destination_alpha == BlendFactor::Zero
+        && eq.alpha_operation == BlendOperation::Add
+}
+
+pub(super) fn output_fits(format: vk::Format, form: Form) -> bool {
+    let channels = match format {
+        vk::Format::R16_SFLOAT => 1,
+        vk::Format::R16G16_SFLOAT => 2,
+        vk::Format::R16G16B16A16_SFLOAT => 4,
+        _ => return false,
+    };
+    matches!(form.float_fmt(), Some(FloatFmt::F32 | FloatFmt::Half))
+        && form.lanes >= channels
+        && form.lanes <= 4
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn only_fast_direct_half_products_are_accepted() {
+        let eq = BlendEquation {
+            source_rgb: BlendFactor::DestinationColor,
+            destination_rgb: BlendFactor::Zero,
+            rgb_operation: BlendOperation::Add,
+            source_alpha: BlendFactor::DestinationAlpha,
+            destination_alpha: BlendFactor::Zero,
+            alpha_operation: BlendOperation::Add,
+        };
+        for format in [
+            vk::Format::R16_SFLOAT,
+            vk::Format::R16G16_SFLOAT,
+            vk::Format::R16G16B16A16_SFLOAT,
+        ] {
+            assert!(accepts(format, eq, BlendMath::Fast));
+            assert!(!accepts(format, eq, BlendMath::Rounded));
+            for changed in [
+                BlendEquation {
+                    source_rgb: BlendFactor::SourceColor,
+                    ..eq
+                },
+                BlendEquation {
+                    destination_rgb: BlendFactor::One,
+                    ..eq
+                },
+                BlendEquation {
+                    rgb_operation: BlendOperation::Subtract,
+                    ..eq
+                },
+                BlendEquation {
+                    source_alpha: BlendFactor::SourceAlpha,
+                    ..eq
+                },
+                BlendEquation {
+                    destination_alpha: BlendFactor::One,
+                    ..eq
+                },
+                BlendEquation {
+                    alpha_operation: BlendOperation::Subtract,
+                    ..eq
+                },
+            ] {
+                assert!(!accepts(format, changed, BlendMath::Fast));
+            }
+        }
+        for format in [
+            vk::Format::R32_SFLOAT,
+            vk::Format::R8G8B8A8_UNORM,
+            vk::Format::R16G16_UNORM,
+        ] {
+            assert!(!accepts(format, eq, BlendMath::Fast));
+        }
+    }
+}
