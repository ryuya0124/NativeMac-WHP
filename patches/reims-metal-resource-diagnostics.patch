diff --git a/guest/metal-compat/ResourceDiagnostic.hpp b/guest/metal-compat/ResourceDiagnostic.hpp
new file mode 100644
index 0000000..40d54ff
--- /dev/null
+++ b/guest/metal-compat/ResourceDiagnostic.hpp
@@ -0,0 +1,26 @@
+#pragma once
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+namespace ReimsABI {
+// An explicit diagnostic client can inspect only resource calls by its own task.
+struct ResourceDiagnostic {
+    uint32_t sequence;
+    uint32_t size;
+    int32_t status;
+    uint32_t reserved;
+    uint8_t bytes[512];
+
+    void record(const void *input, size_t length, int32_t result) {
+        if (!input || length > sizeof(bytes)) return;
+        ++sequence;
+        size = static_cast<uint32_t>(length);
+        status = result;
+        reserved = 0;
+        memset(bytes, 0, sizeof(bytes));
+        memcpy(bytes, input, length);
+    }
+};
+static_assert(sizeof(ResourceDiagnostic) == 528, "diagnostic wire size");
+}
