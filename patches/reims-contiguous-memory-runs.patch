+    // Only fully valid, length-exact plans can be grouped. Refused plans keep their
+    // original partial mappings and failure order. Never cross a host-map boundary.
+    fn contiguous_ranges<'a>(&self, ranges: &'a [PhysRange], total: u64) -> Cow<'a, [PhysRange]> {
+        let mut sum = 0u64;
+        let host_page = self.platform.vm().page_size();
+        for range in ranges {
+            let Some(end) = range.physical_address.checked_add(range.physical_length) else {
+                return Cow::Borrowed(ranges);
+            };
+            let Some(next) = sum.checked_add(range.physical_length) else {
+                return Cow::Borrowed(ranges);
+            };
+            if range.physical_address == 0 || range.physical_length % host_page != 0 ||
+                (range.physical_length != 0 && !self.ranges.iter().any(|map| {
+                    if range.physical_address < map.physical_address ||
+                        range.physical_address >= map.physical_end || end > map.physical_end {
+                        return false;
+                    }
+                    addr_u64(map.virtual_address).checked_add(range.physical_address - map.physical_address)
+                        .is_some_and(|source| source % host_page == 0)
+                })) {
+                return Cow::Borrowed(ranges);
+            }
+            sum = next;
+        }
+        if sum != total || ranges.len() < 2 { return Cow::Borrowed(ranges); }
+        let mut grouped: Vec<PhysRange> = Vec::with_capacity(ranges.len());
+        for range in ranges {
+            if let Some(last) = grouped.last_mut() {
+                if last.physical_length != 0 && range.physical_length != 0 &&
+                    last.physical_address.checked_add(last.physical_length) == Some(range.physical_address) &&
+                    self.ranges.iter().any(|map| last.physical_address >= map.physical_address &&
+                        range.physical_address + range.physical_length <= map.physical_end) {
+                    last.physical_length += range.physical_length;
+                    continue;
+                }
+            }
+            grouped.push(*range);
+        }
+        Cow::Owned(grouped)
+    }
