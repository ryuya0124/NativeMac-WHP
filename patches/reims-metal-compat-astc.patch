diff --git a/guest/metal-compat/TextureABI.hpp b/guest/metal-compat/TextureABI.hpp
new file mode 100644
index 0000000..2a910e1
--- /dev/null
+++ b/guest/metal-compat/TextureABI.hpp
@@ -0,0 +1,46 @@
+#pragma once
+#include "ResourceABI.hpp"
+
+namespace ReimsABI {
+// The ASTC sRGB, LDR and HDR enum ranges, including the private 4x2/8x4 forms.
+inline bool astcFormat(uint16_t format) {
+    return (format >= 185 && format <= 200) ||
+           (format >= 203 && format <= 218) ||
+           (format >= 221 && format <= 236);
+}
+
+// Read only known APV texture object records. Other object types/opcodes stay
+// with the original driver; malformed records are never scanned heuristically.
+inline bool texturePixelFormat(uint32_t type, const void *bytes, size_t length,
+                               uint16_t &format) {
+    if (!bytes) return false;
+    size_t command = 0;
+    if (type == 2 || type == 3 || type == 12 || type == 17 || type == 18) {
+        if (length < 36) return false;
+        size_t mips = read<uint16_t>(bytes, 12) & 0x3fff;
+        size_t planes = type == 12 || type == 18 ? 2 : 1;
+        command = 12 + (24 + mips * 36) * planes;
+    } else if (type != 8 && type != 9) return false;
+    if (command > length || length - command < 8) return false;
+    uint32_t opcode = read<uint32_t>(bytes, command);
+    size_t descriptor = command + 8;
+    bool second = false;
+    size_t need = 0;
+    switch (opcode) {
+        case 1: case 48: descriptor += 4; need = 32; break;
+        case 52: case 53: descriptor += 4; need = 39; second = true; break;
+        case 9: descriptor += 24; need = 32; break;
+        case 55: descriptor += 24; need = 39; second = true; break;
+        case 21: descriptor += 8; need = 32; break;
+        case 56: descriptor += 8; need = 39; second = true; break;
+        case 7: case 8: case 27:
+            if (length - command < 20) return false;
+            format = read<uint16_t>(bytes, command + 16);
+            return true;
+        default: return false;
+    }
+    if (descriptor > length || length - descriptor < need) return false;
+    format = read<uint16_t>(bytes, descriptor + (second ? 1 : 2));
+    return true;
+}
+}
