--- a/guest/metal-compat/abi-test.cpp
+++ b/guest/metal-compat/abi-test.cpp
@@ -1,6 +1,7 @@
 #include "ResourceABI.hpp"
 #include "SubmissionABI.hpp"
 #include "DirtyABI.hpp"
+#include "TextureABI.hpp"
 #include <assert.h>
 #include <initializer_list>
 
@@ -192,7 +193,42 @@ static void checkEvents() {
     assert(!ReimsABI::submissionSize(emptySource, sizeof(emptySource), emptyCommands, sizeof(emptyCommands)));
 }
 
+static void checkTextureFormats() {
+    uint16_t format = 0;
+    uint8_t data[1024] {};
+    for (uint32_t type : {2U,3U,12U,17U,18U,8U,9U}) {
+        for (uint16_t mips : {0U,1U,7U}) {
+            memset(data,0,sizeof(data));
+            ReimsABI::write<uint16_t>(data,12,0x8000 | mips);
+            size_t command = type == 8 || type == 9 ? 0 :
+                12+(24+mips*36)*(type == 12 || type == 18 ? 2 : 1);
+            for (uint32_t opcode : {1U,52U,9U,55U,21U,56U,48U,53U}) {
+                bool second = opcode == 52 || opcode == 55 || opcode == 56 || opcode == 53;
+                size_t offset = command+8+((opcode == 9 || opcode == 55) ? 24 :
+                    (opcode == 21 || opcode == 56) ? 8 : 4);
+                size_t end = offset+(second ? 39 : 32);
+                ReimsABI::write<uint32_t>(data,command,opcode);
+                for (uint16_t pixel : {80U,185U,200U,203U,212U,218U,221U,236U,237U}) {
+                    ReimsABI::write<uint16_t>(data,offset+(second ? 1 : 2),pixel);
+                    assert(ReimsABI::texturePixelFormat(type,data,end,format) && format == pixel);
+                    for (size_t truncated = 0; truncated < end; truncated++)
+                        assert(!ReimsABI::texturePixelFormat(type,data,truncated,format));
+                }
+            }
+        }
+    }
+    assert(!ReimsABI::texturePixelFormat(1,data,sizeof(data),format));
+    assert(!ReimsABI::texturePixelFormat(8,nullptr,sizeof(data),format));
+    ReimsABI::write<uint32_t>(data,0,0xffffffffU);
+    assert(!ReimsABI::texturePixelFormat(8,data,sizeof(data),format));
+    for (uint16_t pixel : {185U,194U,200U,203U,212U,218U,221U,230U,236U})
+        assert(ReimsABI::astcFormat(pixel));
+    for (uint16_t pixel : {0U,80U,130U,184U,201U,202U,219U,220U,237U,65535U})
+        assert(!ReimsABI::astcFormat(pixel));
+}
+
 int main() {
+    checkTextureFormats();
     checkComputePipelines();
     assert(ReimsABI::batchSize(1, 48, 48) == 32);
     assert(ReimsABI::batchSize(64, 48, 3072) == 1544);
