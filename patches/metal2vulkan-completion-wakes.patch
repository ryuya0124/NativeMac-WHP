+++ b/crates/metal2vulkan-runtime/src/command_buffer/completion/wake.rs
@@ -0,0 +1,41 @@
+//! Separate conditions for queue waiters and the completion/drain thread.
+
+use std::sync::Condvar;
+
+pub(super) struct Wakes {
+    completion: Condvar,
+    queues: Vec<Condvar>,
+}
+
+impl Wakes {
+    pub(super) fn new(queues: usize) -> Self {
+        Self {
+            completion: Condvar::new(),
+            queues: (0..queues).map(|_| Condvar::new()).collect(),
+        }
+    }
+
+    pub(super) fn len(&self) -> usize {
+        self.queues.len()
+    }
+
+    pub(super) fn completion(&self) -> &Condvar {
+        &self.completion
+    }
+
+    pub(super) fn queue(&self, queue: usize) -> &Condvar {
+        &self.queues[queue]
+    }
+
+    /// Global predicate changes (stop, exit or a failure drain) reach every waiter.
+    pub(super) fn all(&self) {
+        self.completion.notify_all();
+        for queue in &self.queues {
+            queue.notify_all();
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "../../tests/completion_wakes.rs"]
+mod tests;
diff --git a/crates/metal2vulkan-runtime/src/tests/completion_wakes.rs b/crates/metal2vulkan-runtime/src/tests/completion_wakes.rs
new file mode 100644
index 0000000..474055d
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/tests/completion_wakes.rs
@@ -0,0 +1,79 @@
+use super::Wakes;
+use std::sync::{mpsc, Arc, Mutex};
+use std::time::Duration;
+
+#[derive(Default)]
+struct State {
+    generations: [u32; 5],
+    stopping: bool,
+}
+
+// Repeated notifications can land before a worker actually sleeps. Each worker
+// checks its generation under the same mutex as the producer, as completion does.
+// Idle queue waiters must also leave at a global stop.
+#[test]
+fn progress_before_or_during_wait_and_global_stop() {
+    let state = Arc::new(Mutex::new(State::default()));
+    let wakes = Arc::new(Wakes::new(4));
+    let (ready_tx, ready_rx) = mpsc::channel();
+    let (done_tx, done_rx) = mpsc::channel();
+    let mut workers = Vec::new();
+    for index in 0..5 {
+        let state = Arc::clone(&state);
+        let wakes = Arc::clone(&wakes);
+        let ready = ready_tx.clone();
+        let done = done_tx.clone();
+        workers.push(std::thread::spawn(move || {
+            let condition = if index == 4 {
+                wakes.completion()
+            } else {
+                wakes.queue(index)
+            };
+            let mut observed = 0;
+            let mut returned = 0;
+            let mut state = state.lock().unwrap();
+            ready.send(index).unwrap();
+            loop {
+                while !state.stopping && state.generations[index] == observed {
+                    state = condition.wait(state).unwrap();
+                    returned += 1;
+                }
+                if state.stopping {
+                    return (index, observed, returned);
+                }
+                observed = state.generations[index];
+                done.send((index, observed)).unwrap();
+            }
+        }));
+    }
+    for _ in 0..5 {
+        ready_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+    }
+    let mut expected = [0; 5];
+    for round in 0..512 {
+        let queue = round % 2;
+        {
+            let mut state = state.lock().unwrap();
+            state.generations[queue] += 1;
+            state.generations[4] += 1;
+            expected = state.generations;
+        }
+        wakes.queue(queue).notify_one();
+        wakes.completion().notify_one();
+        let mut seen = [false; 5];
+        for _ in 0..2 {
+            let (index, generation) = done_rx.recv_timeout(Duration::from_secs(5)).unwrap();
+            assert!(index == queue || index == 4);
+            assert!(!seen[index]);
+            assert_eq!(generation, expected[index]);
+            seen[index] = true;
+        }
+    }
+    state.lock().unwrap().stopping = true;
+    wakes.all();
+    for worker in workers {
+        let (index, observed, returned) = worker.join().unwrap();
+        assert_eq!(observed, expected[index]);
+        println!("queue/completion {index}: {observed} generations, {returned} wait returns");
+    }
+}
