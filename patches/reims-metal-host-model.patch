 class ReimsMetalClient;
 
@@ -1462,6 +1463,13 @@ bool matched(void *, void *, IOService *service, IONotifier *) {
             selected = pci->configRead16(kIOPCIConfigVendorID) == 0x106b &&
                        pci->configRead16(kIOPCIConfigDeviceID) == 0xeeee;
             if (selected) {
+                auto hostModel = OSDynamicCast(OSData, pci->getProperty("reims-gpu-model"));
+                if (hostModel && ReimsABI::validModelName(hostModel->getBytesNoCopy(), hostModel->getLength())) {
