diff --git a/guest/metal-compat/ModelName.hpp b/guest/metal-compat/ModelName.hpp
new file mode 100644
index 0000000..c8d7c3e
--- /dev/null
+++ b/guest/metal-compat/ModelName.hpp
@@ -0,0 +1,16 @@
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+
+namespace ReimsABI {
+// A host-provided display label is distinct from hardware IDs and capability
+// answers. Its wire representation is bounded printable ASCII with one NUL.
+inline bool validModelName(const void *data, size_t size) {
+    if (!data || size < 2 || size > 64) return false;
+    auto text = static_cast<const uint8_t *>(data);
+    if (text[size - 1]) return false;
+    for (size_t i = 0; i + 1 < size; i++)
+        if (text[i] < 32 || text[i] > 126) return false;
+    return true;
+}
+}
diff --git a/guest/metal-compat/README.md b/guest/metal-compat/README.md
index 4f251a6..6c9b0c9 100644
--- a/guest/metal-compat/README.md
+++ b/guest/metal-compat/README.md
@@ -11,6 +11,13 @@ The transport returns actual legacy resource IDs, compiler information and
 GPU completions. It does not override GPU-family queries or emulate a
 successful draw. Untranslated requests fail explicitly.
 
+The selected PCI endpoint may provide a `reims-gpu-model` property containing
+1–63 printable ASCII characters followed by NUL. The bridge publishes that
+host renderer label as the PCI endpoint's and accelerator's `model` data.
+Absent or malformed labels preserve the driver's original model. This changes
+display metadata only: PCI IDs, GPU families, capability answers, and Metal's
+driver-provided `name` are unchanged.
+
 ## Build and check
 
 First review and commit changes to this directory, then export a new source
