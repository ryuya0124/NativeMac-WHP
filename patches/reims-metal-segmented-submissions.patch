+static void checkSegmentedSubmission() {
+    uint8_t source[136] {}, commands[256] {}, copied[256] {}, output[128] {};
+    ReimsABI::write<uint32_t>(commands, 0, 15);
+    ReimsABI::write<uint32_t>(commands, 4, 172);
+    ReimsABI::write<uint32_t>(source, 8, 1);
+    ReimsABI::write<uint32_t>(source, 12, 0x40000001);
+    ReimsABI::write<uint32_t>(source, 20, 172);
+    ReimsABI::write<uint32_t>(source, 32, 1);
+    ReimsABI::write<uint32_t>(source, 36, 0x80000070);
+    ReimsABI::write<uint32_t>(source, 48, 172);
+    ReimsABI::write<uint32_t>(source, 64, 1);
+    ReimsABI::write<uint32_t>(source, 68, 1);
+    ReimsABI::write<uint32_t>(source, 72, 7);
+    ReimsABI::write<uint32_t>(source, 96, 4);
+    ReimsABI::write<uint16_t>(source, 120, 3);
+    ReimsABI::write<uint16_t>(source, 134, 1);
+    auto lookup = [](void *, uint32_t id, uint64_t &length) { length = 4096; return id == 7; };
+    for (uint32_t segments : {1U, 2U, 3U}) {
+        uint32_t bytes = 12 + segments * 8;
+        ReimsABI::write<uint32_t>(commands, 172, 0x10000);
+        ReimsABI::write<uint32_t>(commands, 176, bytes);
+        ReimsABI::write<uint32_t>(commands, 180, segments);
+        for (uint32_t i = 0; i < segments; i++) {
+            ReimsABI::write<uint32_t>(commands, 184 + i * 8, 10 + i);
+            ReimsABI::write<uint32_t>(commands, 188 + i * 8, 64 + i * 4);
+        }
+        // Two commands in one resource group, with a different number of segments.
+        uint32_t next = 172 + bytes, end = next + 20;
+        ReimsABI::write<uint32_t>(commands, next, 0x10000);
+        ReimsABI::write<uint32_t>(commands, next + 4, 20);
+        ReimsABI::write<uint32_t>(commands, next + 8, 1);
+        ReimsABI::write<uint32_t>(commands, next + 12, 20);
+        ReimsABI::write<uint32_t>(commands, next + 16, 80);
+        ReimsABI::write<uint32_t>(source, 52, end);
+        memcpy(copied, commands, sizeof(commands));
+        assert(ReimsABI::submission(source, sizeof(source), commands, end, output,
+            sizeof(output), nullptr, lookup, copied));
+        assert(!memcmp(copied, commands, sizeof(commands)));
+        assert(ReimsABI::read<uint32_t>(output, 24) == 172);
+        assert(ReimsABI::read<uint32_t>(output, 28) == end);
+        for (uint32_t size = 172; size < end; size++)
+            assert(!ReimsABI::submissionSize(source, sizeof(source), commands, size));
+        for (uint32_t wrong : {0U, segments + 1, UINT32_MAX}) {
+            ReimsABI::write<uint32_t>(commands, 180, wrong);
+            assert(!ReimsABI::submissionSize(source, sizeof(source), commands, end));
+        }
+        ReimsABI::write<uint32_t>(commands, 180, segments);
+        for (uint32_t wrong : {0U, 8U, bytes - 4, bytes + 4, UINT32_MAX}) {
+            ReimsABI::write<uint32_t>(commands, 176, wrong);
+            assert(!ReimsABI::submissionSize(source, sizeof(source), commands, end));
+        }
+        ReimsABI::write<uint32_t>(commands, 176, bytes);
+        ReimsABI::write<uint32_t>(commands, next, 0x10001);
+        assert(!ReimsABI::submissionSize(source, sizeof(source), commands, end));
+        ReimsABI::write<uint32_t>(commands, next, 0x10000);
+        ReimsABI::write<uint32_t>(source, 52, end - 1);
+        assert(!ReimsABI::submissionSize(source, sizeof(source), commands, end));
+    }
+}
