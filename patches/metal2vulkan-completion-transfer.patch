diff --git a/crates/metal2vulkan-runtime/src/tests/blit_scratch.rs b/crates/metal2vulkan-runtime/src/tests/blit_scratch.rs
new file mode 100644
index 0000000..9e68998
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/tests/blit_scratch.rs
@@ -0,0 +1,226 @@
+//! Scratch reuse must preserve every intermediate memmove result and its lifetime.
+#![cfg(any(m2v_gpu, m2v_cpu_icd))]
+
+use crate::{CommandBufferStatus, Device, DeviceKind, DeviceOptions, ResourceOptions};
+use std::time::Duration;
+
+struct HostPages {
+    pointer: std::ptr::NonNull<u8>,
+    layout: std::alloc::Layout,
+}
+// SAFETY: ownership can move to the runtime's deallocator. CPU writes precede all
+// GPU uses, and the test reads GPU-written bytes only after completion.
+unsafe impl Send for HostPages {}
+// SAFETY: shared ownership only keeps the allocation alive; it grants no safe byte access.
+unsafe impl Sync for HostPages {}
+impl Drop for HostPages {
+    fn drop(&mut self) {
+        // SAFETY: this is the allocation and layout from alloc_zeroed, released once.
+        unsafe { std::alloc::dealloc(self.pointer.as_ptr(), self.layout) };
+    }
+}
+
+#[test]
+fn staged_texture_transfers_share_scratch_and_preserve_guard_bytes(
+) -> Result<(), Box<dyn std::error::Error>> {
+    use crate::{BlitOption, HostMemory, Origin, Size, TextureDescriptor};
+    use metal2vulkan::metal::{PixelFormat, TextureUsage};
+    use std::sync::Arc;
+
+    let options = DeviceOptions {
+        kinds: if cfg!(m2v_cpu_icd) {
+            vec![DeviceKind::Cpu]
+        } else {
+            vec![
+                DeviceKind::Discrete,
+                DeviceKind::Integrated,
+                DeviceKind::Virtual,
+            ]
+        },
+        ..DeviceOptions::default()
+    };
+    let device = Device::system_default_with(&options)?;
+    let queue = device.new_command_queue()?;
+    let layout = std::alloc::Layout::from_size_align(131072, 65536)?;
+    // SAFETY: the allocation is page-aligned and owns every page the import can reach.
+    let pointer = std::ptr::NonNull::new(unsafe { std::alloc::alloc_zeroed(layout) })
+        .ok_or("host allocation failed")?;
+    let pages = Arc::new(HostPages { pointer, layout });
+    let mut expected = vec![0xa5; 4096];
+    for (index, byte) in expected[16..80].iter_mut().enumerate() {
+        *byte = (index * 37 + 11) as u8;
+    }
+    // SAFETY: the logical buffer starts two bytes into the owned allocation.
+    let logical = unsafe { std::ptr::NonNull::new_unchecked(pointer.as_ptr().add(2)) };
+    // SAFETY: the logical range is inside the allocation and no GPU use has started.
+    unsafe { std::ptr::copy_nonoverlapping(expected.as_ptr(), logical.as_ptr(), expected.len()) };
+    let kept = Arc::clone(&pages);
+    // SAFETY: both this test and the deallocator retain every page through the import's life.
+    let buffer = unsafe {
+        device.new_buffer_with_bytes_no_copy(
+            HostMemory::new(logical),
+            4096,
+            ResourceOptions::shared(),
+            Some(Box::new(move |_, _| drop(kept))),
+        )?
+    };
+    assert_eq!(
+        buffer.at(0).1 % 4,
+        2,
+        "the fixture did not select staged transfers"
+    );
+    let mut desc = TextureDescriptor::texture_2d(PixelFormat::RGBA8Unorm, 4, 4, false);
+    desc.usage = TextureUsage::SHADER_READ;
+    desc.resource_options = ResourceOptions::private();
+    let texture = device.new_texture(&desc)?;
+    let readback = device.new_buffer(4096, ResourceOptions::shared())?;
+    let command = queue.command_buffer()?;
+    let mut blit = command.blit_command_encoder()?;
+    blit.copy_from_buffer_to_texture(
+        &buffer,
+        16,
+        16,
+        0,
+        Size::new(4, 4, 1),
+        &texture,
+        0,
+        0,
+        Origin::new(0, 0, 0),
+        BlitOption::None,
+    )?;
+    let scratch = blit.copy_scratch.clone().expect("upload did not stage");
+    blit.copy_from_texture_to_buffer(
+        &texture,
+        0,
+        0,
+        Origin::new(0, 0, 0),
+        Size::new(4, 4, 1),
+        &buffer,
+        128,
+        16,
+        0,
+        BlitOption::None,
+    )?;
+    assert_eq!(
+        blit.copy_scratch.as_ref(),
+        Some(&scratch),
+        "download allocated another scratch"
+    );
+    blit.copy_from_buffer_to_buffer(&buffer, 0, &readback, 0, 4096)?;
+    blit.end_encoding()?;
+    drop(scratch);
+    drop(texture);
+    drop(buffer);
+    command.commit()?;
+    command
+        .wait_until_completed_for(Duration::from_secs(20))
+        .expect("staged transfers did not complete");
+    assert_eq!(command.status(), CommandBufferStatus::Completed);
+    expected.copy_within(16..80, 128);
+    let at = readback.contents().ok_or("readback not mapped")?;
+    // SAFETY: all GPU writes have completed and the full read lies in the live buffer.
+    let observed = unsafe { std::slice::from_raw_parts(at.as_ptr(), 4096) };
+    assert_eq!(observed, expected);
+    println!(
+        "device={}, verifiedBytes=4096, stagedUploads=1, stagedDownloads=1, scratchAllocations=1",
+        device.name()
+    );
+    Ok(())
+}
+
+#[test]
+fn overlap_copies_reuse_storage_without_overwriting_prior_results(
+) -> Result<(), Box<dyn std::error::Error>> {
+    let options = DeviceOptions {
+        kinds: if cfg!(m2v_cpu_icd) {
+            vec![DeviceKind::Cpu]
+        } else {
+            vec![
+                DeviceKind::Discrete,
+                DeviceKind::Integrated,
+                DeviceKind::Virtual,
+            ]
+        },
+        ..DeviceOptions::default()
+    };
+    let device = Device::system_default_with(&options)?;
+    let queue = device.new_command_queue()?;
+    let mut expected: Vec<u8> = (0..65536).map(|i| ((i * 37 + 13) % 251) as u8).collect();
+    let data = device.new_buffer_with_bytes(&expected, ResourceOptions::shared())?;
+    let cases = [
+        (0, 1, 8192),
+        (1, 0, 4096),
+        (0, 0, 16384),
+        (3, 15, 1024),
+        (10, 11, 32768),
+        (17, 1, 8192),
+        (64, 80, 2048),
+    ];
+    let length = expected.len() as u64;
+    let readback = device.new_buffer(length * cases.len() as u64, ResourceOptions::shared())?;
+    let command = queue.command_buffer()?;
+    let mut blit = command.blit_command_encoder()?;
+    blit.copy_from_buffer_to_buffer(&data, length, &data, length, 0)?;
+    assert!(
+        blit.copy_scratch.is_none(),
+        "empty copy allocated temporary storage"
+    );
+    let mut snapshots = Vec::new();
+    let mut scratches: Vec<crate::Buffer> = Vec::new();
+    for (index, (from, to, size)) in cases.into_iter().enumerate() {
+        let previous = blit.copy_scratch.clone();
+        blit.copy_from_buffer_to_buffer(&data, from, &data, to, size)?;
+        let scratch = blit
+            .copy_scratch
+            .as_ref()
+            .expect("overlap did not use scratch");
+        if let Some(previous) = previous {
+            if previous.length() >= size {
+                assert_eq!(scratch, &previous, "fitting copy allocated another buffer");
+            } else {
+                assert_ne!(scratch, &previous, "larger copy kept undersized storage");
+            }
+        }
+        if !scratches.contains(scratch) {
+            scratches.push(scratch.clone());
+        }
+        expected.copy_within(from as usize..(from + size) as usize, to as usize);
+        snapshots.push(expected.clone());
+        blit.copy_from_buffer_to_buffer(&data, 0, &readback, index as u64 * length, length)?;
+    }
+    let scratch = blit.copy_scratch.clone();
+    assert!(blit
+        .copy_from_buffer_to_buffer(&data, length, &data, 0, 1)
+        .is_err());
+    assert_eq!(
+        blit.copy_scratch, scratch,
+        "refused copy changed scratch storage"
+    );
+    assert_eq!(scratches.len(), 3);
+    // No test-owned handles keep temporary allocations alive after this point.
+    drop(scratch);
+    drop(scratches);
+    blit.end_encoding()?;
+    drop(data);
+    command.commit()?;
+    command
+        .wait_until_completed_for(Duration::from_secs(20))
+        .expect("overlap copies did not complete");
+    assert_eq!(command.status(), CommandBufferStatus::Completed);
+    let at = readback.contents().ok_or("readback not mapped")?;
+    // SAFETY: GPU completion precedes these reads, all inside the live buffer.
+    let bytes = unsafe { std::slice::from_raw_parts(at.as_ptr(), readback.length() as usize) };
+    for (index, snapshot) in snapshots.iter().enumerate() {
+        assert_eq!(
+            &bytes[index * length as usize..(index + 1) * length as usize],
+            snapshot
+        );
+    }
+    println!(
+        "device={}, snapshots={}, verifiedBytes={}, scratchAllocations=3",
+        device.name(),
+        snapshots.len(),
+        bytes.len()
+    );
+    Ok(())
+}
