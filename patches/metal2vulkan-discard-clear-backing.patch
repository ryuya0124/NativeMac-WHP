+#[test]
+fn a_discard_without_draws_keeps_the_surface_in_place() {
+    on_device(|device, _| {
+        let Some((mapping, buffer, texture)) = surface(device, 67) else {
+            return;
+        };
+        let rule = by_the_rule(device) && aliased(&texture);
+        let queue = device.new_command_queue().unwrap();
+        let before = device.work_counts();
+        pass(&queue, &[(&texture, LoadAction::DontCare, None)]);
+        assert_eq!(ways(device, &before), (u64::from(rule), 0));
+        assert_eq!(
+            mapping.read(0..(W * H * TEXEL) as usize),
+            counting((W * H * TEXEL) as usize, 67)
+        );
+        drop((texture, buffer));
+        drop(mapping);
+    });
+}
