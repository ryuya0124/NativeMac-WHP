+/// A discard resolved to a tile clear takes the kept device image even without another
+/// attachment forcing it apart. Full and partial coverage match the private reference,
+/// including every byte outside the scissor. The path counters prove selection on NVIDIA.
+#[test]
+fn a_discard_clear_renders_through_the_kept_image_and_preserves_other_tiles() {
+    on_device(|device, messages| {
+        messages.take_notices();
+        for scissor in [None, Some(ScissorRect::new(32, 0, 64, 32))] {
+            let Some((mapping, buffer, texture)) = surface(device, 61) else {
+                return;
+            };
+            let rule = by_the_rule(device) && aliased(&texture);
+            let queue = device.new_command_queue().unwrap();
+            let pipeline = blending(device, PixelFormat::BGRA8Unorm);
+            let n = (W * H * TEXEL) as usize;
+            let bytes = counting(n, 61);
+            let expected = private_holding(&queue, &bytes, [W, H]);
+            blend_pass_with_load(
+                &queue,
+                &pipeline,
+                &expected,
+                scissor,
+                &[WHOLE],
+                None,
+                LoadAction::DontCare,
+            );
+            let before = device.work_counts();
+            blend_pass_with_load(
+                &queue,
+                &pipeline,
+                &texture,
+                scissor,
+                &[WHOLE],
+                None,
+                LoadAction::DontCare,
+            );
+            let selected = ways(device, &before);
+            println!(
+                "DISCARD-CLEAR on {}: by rule {rule}, ways {selected:?}",
+                device.name()
+            );
+            assert_eq!(selected, (0, u64::from(rule)));
+            assert_eq!(mapping.read(0..n), blit_out(&queue, &expected));
+            if let Some(scissor) = scissor {
+                let pages = mapping.read(0..n);
+                for i in 0..n {
+                    let x = (i as u64 / TEXEL) % W;
+                    let y = (i as u64 / TEXEL) / W;
+                    if !(scissor.x..scissor.x + scissor.width).contains(&x)
+                        || !(scissor.y..scissor.y + scissor.height).contains(&y)
+                    {
+                        assert_eq!(pages[i], bytes[i], "byte {i} outside the cleared tiles");
+                    }
+                }
+            }
+            drop((expected, texture, buffer));
+            drop(mapping);
+        }
+    });
+}
