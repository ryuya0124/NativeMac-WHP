+static void checkAliasRelease() {
+    struct Alias {
+        bool mapped = true, ownerAlive = true, canMap = true;
+        unsigned unmaps = 0, remaps = 0;
+        void unmap() { assert(mapped && ownerAlive); mapped = false; ++unmaps; }
+        bool remap() {
+            assert(!mapped && ownerAlive);
+            ++remaps;
+            mapped = canMap;
+            return mapped;
+        }
+    };
+    using ReimsABI::AliasRelease;
+    Alias released;
+    auto result = ReimsABI::releaseAlias(released, [&] {
+        assert(!released.mapped && released.ownerAlive);
+        released.ownerAlive = false;
+        return true;
+    });
+    assert(result == AliasRelease::Released && !released.mapped && !released.ownerAlive);
+    assert(released.unmaps == 1 && released.remaps == 0);
+
+    Alias retained;
+    result = ReimsABI::releaseAlias(retained, [&] {
+        assert(!retained.mapped && retained.ownerAlive);
+        return false;
+    });
+    assert(result == AliasRelease::Retained && retained.mapped && retained.ownerAlive);
+    assert(retained.unmaps == 1 && retained.remaps == 1);
+    result = ReimsABI::releaseAlias(retained, [&] {
+        assert(!retained.mapped && retained.ownerAlive);
+        retained.ownerAlive = false;
+        return true;
+    });
+    assert(result == AliasRelease::Released && !retained.mapped && !retained.ownerAlive);
+    assert(retained.unmaps == 2 && retained.remaps == 1);
+
+    Alias failed;
+    failed.canMap = false;
+    result = ReimsABI::releaseAlias(failed, [&] {
+        assert(!failed.mapped && failed.ownerAlive);
+        return false;
+    });
+    assert(result == AliasRelease::Unmapped && !failed.mapped && failed.ownerAlive);
+    assert(failed.unmaps == 1 && failed.remaps == 1);
+}
+
 int main() {
+    checkAliasRelease();
     checkTextureFormats();
     checkComputePipelines();
     assert(ReimsABI::batchSize(1, 48, 48) == 32);
