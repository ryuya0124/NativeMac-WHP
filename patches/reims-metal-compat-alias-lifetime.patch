new file mode 100644
index 0000000..cc034bb
--- /dev/null
+++ b/guest/metal-compat/AliasLifetime.hpp
@@ -0,0 +1,14 @@
+#pragma once
+
+namespace ReimsABI {
+enum class AliasRelease { Released, Retained, Unmapped };
+
+// Withdraw CPU access before the backing owner may recycle its pages. A refused
+// release leaves the owner alive, so access can be restored for a later retry.
+template <typename Alias, typename Release>
+AliasRelease releaseAlias(Alias &alias, Release release) {
+    alias.unmap();
+    if (release()) return AliasRelease::Released;
+    return alias.remap() ? AliasRelease::Retained : AliasRelease::Unmapped;
+}
+}
