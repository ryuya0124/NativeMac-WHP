+        let vm = WindowsVm;
+        let length = 64 * 1024 * 1024;
+        let source = vm.allocate_anywhere(length).unwrap();
+        let mut ranges = Vec::new();
+        for page in 0..length / PAGE {
+            let from = source.wrapping_add((page ^ 1) * PAGE);
+            // SAFETY: the source has length bytes and every page is in that allocation.
+            unsafe { from.as_ptr::<u32>().write(page as u32) };
+            ranges.push((from, PAGE));
+        }
