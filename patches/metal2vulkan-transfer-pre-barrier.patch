+/// All earlier accesses precede the copies, which run only in TRANSFER. The full
+/// barrier after the group still publishes every preceding write to later work.
+/// No non-transfer command lies between these two barriers, so the first need
+/// not invalidate the shader stages as well.
+fn before_copies() -> Barrier {
+    Barrier {
+        src: Barrier::everything().src,
+        dst: Access::new(
+            TRANSFER,
+            vk::AccessFlags2::TRANSFER_READ | vk::AccessFlags2::TRANSFER_WRITE,
+        ),
+    }
+}
