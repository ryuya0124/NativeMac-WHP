diff --git a/crates/metal2vulkan-runtime/src/tests/stand_in_copy_barrier.rs b/crates/metal2vulkan-runtime/src/tests/stand_in_copy_barrier.rs
new file mode 100644
index 0000000..69e3810
--- /dev/null
+++ b/crates/metal2vulkan-runtime/src/tests/stand_in_copy_barrier.rs
@@ -0,0 +1,23 @@
+use super::before_copies;
+use crate::tracker::{Access, Barrier};
+use ash::vk;
+
+#[test]
+fn copy_group_keeps_all_prior_accesses_and_only_targets_transfer() {
+    let before = before_copies();
+    assert_eq!(before.src, Barrier::everything().src);
+    assert_eq!(
+        before.dst,
+        Access::new(
+            vk::PipelineStageFlags2::TRANSFER,
+            vk::AccessFlags2::TRANSFER_READ | vk::AccessFlags2::TRANSFER_WRITE,
+        )
+    );
+    let full = Barrier::everything();
+    assert!(full
+        .dst
+        .stages
+        .contains(vk::PipelineStageFlags2::ALL_COMMANDS));
+    assert!(full.dst.access.contains(vk::AccessFlags2::MEMORY_READ));
+    assert!(full.dst.access.contains(vk::AccessFlags2::MEMORY_WRITE));
+}
