+
+#[test]
+fn llvm_bitreverse_checks_integer_shapes_and_overload_suffixes() {
+    for elem in [Elem::I8, Elem::I16, Elem::I32, Elem::I64] {
+        for lanes in [1, 2, 4] {
+            let ty = NumTy { elem, lanes };
+            let operand = Operand::Num(ty);
+            let suffix = if lanes == 1 {
+                format!("i{}", elem.bits())
+            } else {
+                format!("v{lanes}i{}", elem.bits())
+            };
+            assert_eq!(
+                llvm(&format!("llvm.bitreverse.{suffix}"), operand, &[operand]),
+                DeclClass::Llvm(LlvmIntrinsic::Int {
+                    op: LlvmIntOp::BitReverse,
+                    ty
+                })
+            );
+            assert_eq!(
+                llvm(
+                    &format!("llvm.bitreverse.{suffix}"),
+                    operand,
+                    &[operand, operand]
+                ),
+                DeclClass::Mismatch
+            );
+        }
+    }
+    let i32s = Operand::Num(NumTy::scalar(Elem::I32));
+    let f32s = Operand::Num(NumTy::scalar(Elem::F32));
+    assert_eq!(
+        llvm("llvm.bitreverse.i64", i32s, &[i32s]),
+        DeclClass::Mismatch
+    );
+    assert_eq!(
+        llvm("llvm.bitreverse.f32", f32s, &[f32s]),
+        DeclClass::Mismatch
+    );
+}
