+            "bounded_buffers",
+            &[vec![0; THREADS as usize], a, b],
+            (if write { 3 } else { 2 }, 1),
+        ) {
+            assert_eq!(bufs[0], expected, "{stem}: bounded write={write}");
+        }
+    }
+}
