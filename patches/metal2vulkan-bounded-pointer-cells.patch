+/// A bounded pointer read (and a bounded write before it) keeps adjacent data intact. Run both
+/// scheduling orders with independent expected values, including both selected buffers.
+#[test]
+fn bounded_pointer_array_reads_and_writes_preserve_neighboring_data() {
+    for write in [false, true] {
+        let body = r#"entry:
+  %s = alloca %S, align 8
+  %a = getelementptr inbounds %S, ptr %s, i64 0, i32 1, i64 0
+  %b = getelementptr inbounds %S, ptr %s, i64 0, i32 1, i64 1
+  %left = getelementptr inbounds %S, ptr %s, i64 0, i32 0
+  %right = getelementptr inbounds %S, ptr %s, i64 0, i32 2
+  store i32 19, ptr %left, align 4
+  store i32 23, ptr %right, align 4
+  store ptr addrspace(1) %b1, ptr %a, align 8
+  store ptr addrspace(1) %b2, ptr %b, align 8
+  %k = call i32 @air.min.u.i32(i32 %t, i32 1)
+  %kk = zext i32 %k to i64
+  %slot = getelementptr inbounds %S, ptr %s, i64 0, i32 1, i64 %kk
+  WRITE
+  %p = load ptr addrspace(1), ptr %slot, align 8
+  %i = zext i32 %t to i64
+  %q = getelementptr inbounds i32, ptr addrspace(1) %p, i64 %i
+  %v = load i32, ptr addrspace(1) %q, align 4
+  %l = load i32, ptr %left, align 4
+  %r = load i32, ptr %right, align 4
+  %sum = add i32 %l, %r
+  %result = add i32 %v, %sum
+  %out = getelementptr inbounds i32, ptr addrspace(1) %b0, i64 %i
+  store i32 %result, ptr addrspace(1) %out, align 4
+  ret void
+"#
+        .replace(
+            "WRITE",
+            if write {
+                "store ptr addrspace(1) %b2, ptr %slot, align 8"
+            } else {
+                ""
+            },
+        );
+        let text = kernel(
+            "bounded_buffers",
+            3,
+            "%S = type { i32, [2 x ptr addrspace(1)], i32 }",
+            &body,
+        ) + "\ndeclare i32 @air.min.u.i32(i32, i32)\n";
+        let Some(bc) = assemble("bounded_buffers", &text) else {
+            return;
+        };
+        let a = input(3);
+        let b = input(11);
+        let expected: Vec<u32> = (0..THREADS as usize)
+            .map(|i| {
+                if !write && i == 0 {
+                    a[i] + 42
+                } else {
+                    b[i] + 42
