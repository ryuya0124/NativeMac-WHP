+/// Conservative signed-index bounds, without assuming that a GEP stays in an array subobject.
+/// Unsigned minimum with a nonnegative constant and its zero extension supply finite bounds;
+/// the fixed walk depth keeps malformed or cyclic input from growing analysis work.
+fn index_bounds(e: &Entry, value: Value, fuel: u8) -> Option<(i64, i64)> {
+    if let Some(k) = const_index(e, value) {
+        return Some((k, k));
+    }
+    if fuel == 0 {
+        return None;
+    }
+    let Value::Inst(id) = value else { return None };
+    let inst = e.module.func(e.func)?.body.as_ref()?.insts.get(id)?;
+    match &inst.kind {
+        InstKind::Cast {
+            op: CastOp::ZExt,
+            v,
+        } => {
+            let (lo, hi) = index_bounds(e, *v, fuel - 1)?;
+            (lo >= 0).then_some((lo, hi))
+        }
+        InstKind::Call(call) if matches!(&call.callee, Callee::Air { op: AirIntrinsic::Math(math), .. } if math.f == MathFn::IMin(Sign::Unsigned) && math.ty.lanes == 1) => {
+            call.args
+                .iter()
+                .filter_map(|v| const_index(e, *v))
+                .filter(|k| *k >= 0)
+                .min()
+                .map(|hi| (0, hi))
+        }
+        _ => None,
+    }
 }
 
