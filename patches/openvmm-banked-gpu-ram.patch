+    /// Split newly allocated shared RAM into independently backed regions.
+    ///
+    /// This bounds per-section alias bookkeeping on Windows. GPA ranges and
+    /// allocation policy are preserved. Existing, private, and hugepage
+    /// backings retain their original allocation semantics.
+    ///
+    /// # Panics
+    /// Panics if `max_size` is not a power of two of at least 64 KiB.
+    pub fn split_shared(mut self, max_size: u64) -> Vec<Self> {
+        assert!(max_size.is_power_of_two() && max_size >= 64 * 1024);
+        if self.private_memory
+            || self.hugepages
+            || self.existing_mappable.is_some()
+            || self.ranges.is_empty()
+        {
+            return vec![self];
+        }
+
+        let ranges = std::mem::take(&mut self.ranges);
+        let mut requests = Vec::new();
+        for range in ranges {
+            let mut start = range.start();
+            while start < range.end() {
+                let end = start.saturating_add(max_size).min(range.end());
+                requests.push(Self {
+                    ranges: vec![MemoryRange::new(start..end)],
+                    existing_mappable: None,
+                    ..self
+                });
+                start = end;
+            }
+        }
+        requests
+    }
 }
 
