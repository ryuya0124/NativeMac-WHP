+    #[async_test]
+    async fn test_split_shared_cross_bank_io_and_aliases() {
+        const BANK: u64 = 64 * 1024;
+        let mut builder = GuestMemoryBuilder::new();
+        for bank in RamBackingRequest::new(vec![MemoryRange::new(0..3 * BANK)]).split_shared(BANK) {
+            builder = builder.add_backing(bank);
+        }
+        let mgr = builder.build(3 * BANK).await.unwrap();
+        let gm = mgr.client().guest_memory().await.unwrap();
+        let pattern: Vec<u8> = (0..8192).map(|i| (i % 251) as u8).collect();
+        gm.write_at(BANK - 4096, &pattern).unwrap();
+        let mut actual = vec![0; pattern.len()];
+        gm.read_at(BANK - 4096, &mut actual).unwrap();
+        assert_eq!(actual, pattern);
+
+        let regions = gm.sharing().unwrap().get_regions().await.unwrap();
+        assert_eq!(regions.len(), 3);
+        for (i, region) in regions.iter().enumerate() {
+            assert_eq!(region.guest_address, i as u64 * BANK);
+            assert_eq!(region.size, BANK);
+            assert_eq!(region.file_offset, 0);
+            let alias = SparseMapping::new(BANK as usize).unwrap();
+            alias
+                .map_file(0, BANK as usize, region.file.as_ref(), 0, true)
+                .unwrap();
+            alias.write_at(0, &[0xA0 + i as u8]).unwrap();
+            assert_eq!(
+                gm.read_plain::<u8>(region.guest_address).unwrap(),
+                0xA0 + i as u8
+            );
+        }
+        assert!(mgr.shared_memory_backing().is_none());
+    }
