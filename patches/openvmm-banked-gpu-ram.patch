+    #[test]
+    fn test_split_shared_preserves_layout_and_policy() {
+        const BANK: u64 = 64 * 1024;
+        let banks = RamBackingRequest::new(vec![
+            MemoryRange::new(0..BANK + 4096),
+            MemoryRange::new(4 * BANK..6 * BANK),
+        ])
+        .prefetch(true)
+        .transparent_hugepages(true)
+        .host_numa_node(Some(2))
+        .split_shared(BANK);
+        let ranges: Vec<_> = banks.iter().flat_map(|b| b.ranges.clone()).collect();
+        assert_eq!(
+            ranges,
+            vec![
+                MemoryRange::new(0..BANK),
+                MemoryRange::new(BANK..BANK + 4096),
+                MemoryRange::new(4 * BANK..5 * BANK),
+                MemoryRange::new(5 * BANK..6 * BANK),
+            ]
+        );
+        assert_eq!(ranges.iter().map(|r| r.len()).sum::<u64>(), 3 * BANK + 4096);
+        for bank in banks {
+            assert!(bank.prefetch && bank.transparent_hugepages);
+            assert_eq!(bank.host_numa_node, Some(2));
+            assert!(!bank.private_memory && !bank.hugepages);
+        }
