 IOReturn HyperVVMBus::sendVMBusMessageGated(VMBusChannelMessage *message, UInt32 *messageSize, VMBusChannelMessageType *responseType, VMBusChannelMessage *responseMessage) {
   
+  // commandSleep releases the gate. Preserve one response owner while other
+  // device starts run concurrently; otherwise one GPADL response wakes every
+  // waiter, and subsequent OpenResult messages lose their owner.
+  while (_messageBusy) {
+    _cmdGate->commandSleep(&_messageBusy);
+  }
+  _messageBusy = true;
+  _vmbusWaitForMessageType = *responseType;
+
   HypercallStatus hvStatus = kHypercallStatusSuccess;
   IOReturn returnStatus = kIOReturnSuccess;
   bool postCompleted = false;
@@ -146,6 +155,9 @@ IOReturn HyperVVMBus::sendVMBusMessageGated(VMBusChannelMessage *message, UInt32
   
   if (returnStatus != kIOReturnSuccess) {
     HVSYSLOG("Hypercall message type 0x%X failed with status 0x%X", msgEntry->type, hvStatus);
+    _vmbusWaitForMessageType = kVMBusChannelMessageTypeInvalid;
+    _messageBusy = false;
+    _cmdGate->commandWakeup(&_messageBusy);
     return returnStatus;
   }
   
@@ -153,13 +165,16 @@ IOReturn HyperVVMBus::sendVMBusMessageGated(VMBusChannelMessage *message, UInt32
     //
