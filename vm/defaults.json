{
  "schemaVersion": 1,
  "memoryGiB": 12,
  "processors": 8,
  "limits": {
    "maxMemoryGiB": 256,
    "maxProcessors": 64
  },
  "bootValidation": {
    "memoryGiB": 12,
    "processors": 8
  },
  "hypervisor": "whp",
  "allowCpuTranslation": false,
  "allowSoftwareGpu": false,
  "gpuTransport": "compat",
  "rejectAstcTextures": true,
  "displayResolution": "1920x1080"
}
