<Page x:Class="TahoeVm.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark" Background="#0D1421">
    <Page.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#151F30" />
            <Setter Property="BorderBrush" Value="#29374C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="22" />
        </Style>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="28" RowSpacing="20" ColumnSpacing="20" MaxWidth="1500" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.ColumnSpan="2" Spacing="8">
                <TextBlock Text="NATIVE MAC / ENGINE LAB" FontSize="12" CharacterSpacing="180" Foreground="#72C5D5" />
                <TextBlock Text="macOS 26 · Intel" FontSize="34" FontWeight="SemiBold" />
                <TextBlock Text="WHPでCPUを直接実行。必要なデバイスを実装する、WinUI 3の仮想マシン開発環境。" Foreground="#ACBDD1" />
                <InfoBar IsOpen="True" IsClosable="False" Severity="Informational" Margin="0,8,0,0"
                    Title="macOS 26起動・ゲストMetal計算を確認しました"
                    Message="このPCでmacOS 26.6.2を12 GiB・8コアで起動し、RTX 5080によるゲスト内Metal計算4096個の一致を確認しました。VMの画面は別ウィンドウで開きます。" />
                <TextBlock Text="設定上限：RAM 256 GiB / CPU 64コア" Foreground="#72C5D5" />
            </StackPanel>
            <StackPanel Grid.Row="1" Spacing="16">
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="MACOS / WHP VM" FontSize="12" Foreground="#72C5D5" />
                        <NumberBox x:Name="VmMemory" Header="RAM (GiB)" Value="12" Minimum="1" Maximum="256" SpinButtonPlacementMode="Compact" />
                        <NumberBox x:Name="VmProcessors" Header="CPUコア" Value="8" Minimum="1" Maximum="64" SpinButtonPlacementMode="Compact" />
                        <ComboBox x:Name="VmResolution" Header="最大解像度（起動時に適用）" SelectedIndex="0" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="FHD · 1920 × 1080" Tag="1920x1080" />
                            <ComboBoxItem Content="WQHD · 2560 × 1440" Tag="2560x1440" />
                            <ComboBoxItem Content="4K · 3840 × 2160" Tag="3840x2160" />
                        </ComboBox>
                        <Button x:Name="VmStartButton" Content="macOS VMを起動" Click="StartVm_Click" HorizontalAlignment="Stretch" />
                        <Button x:Name="VmStopButton" Content="VMの電源を切る" Click="StopVm_Click" IsEnabled="False" HorizontalAlignment="Stretch" />
                        <TextBlock x:Name="VmStatus" Text="変更したRAM・CPU・解像度は次回起動時に適用します。" Foreground="#ACBDD1" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="CPU / ハードウェア仮想化" FontSize="12" Foreground="#72C5D5" />
                        <TextBlock x:Name="CpuState" Text="未検証" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="CpuDetails" Text="64-bit Long Mode / WHP" Foreground="#ACBDD1" />
                        <Button x:Name="CpuButton" Content="CPUを検証" Click="TestCpu_Click" HorizontalAlignment="Stretch" />
                        <ProgressBar x:Name="CpuProgress" IsIndeterminate="True" Visibility="Collapsed" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel Spacing="10">
                        <TextBlock Text="GPU / Direct3D 11" FontSize="12" Foreground="#72C5D5" />
                        <TextBlock x:Name="GpuState" Text="初期化中" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="GpuDetails" Text="ハードウェアGPUのみを使用します。" Foreground="#ACBDD1" />
                        <TextBlock Text="CPU描画へのフォールバックなし" FontSize="12" Foreground="#8AA4BD" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <SwapChainPanel x:Name="GpuPanel" Height="390" />
                    <Border VerticalAlignment="Bottom" Background="#D00D1421" Padding="20">
                        <StackPanel Spacing="5">
                            <TextBlock x:Name="GpuCaption" Text="GPU描画テスト" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="GpuCaptionDetails" Text="グラデーションとグリッドはGPUシェーダーで描画しています。これはmacOSのゲスト画面ではありません。"
                                Foreground="#ACBDD1" FontSize="12" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="GpuError" Margin="22" Foreground="#FFB4A9" Visibility="Collapsed" />
                </Grid>
            </Border>
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <StackPanel Spacing="12">
                    <TextBlock Text="起動までの実装状況" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock x:Name="CpuMilestone" Text="○ CPU実行：検証待ち" />
                    <TextBlock x:Name="GpuMilestone" Text="○ ホストGPU：検証待ち" />
                    <TextBlock Text="✓ WHP + UEFI：起動確認" Foreground="#ACBDD1" />
                    <TextBlock Text="✓ 元のDMG：変換なしで読み込み" Foreground="#ACBDD1" />
                    <TextBlock Text="✓ macOS仮想GPU：PCI・GOP接続を確認" Foreground="#ACBDD1" />
                    <TextBlock Text="✓ macOS 26：通常OS・初期設定画面を確認" Foreground="#ACBDD1" />
                    <TextBlock Text="✓ 復旧GUI・入力：起動確認" Foreground="#ACBDD1" />
                    <TextBlock Text="✓ ゲストGPU：Metal計算4096個が一致" Foreground="#ACBDD1" />
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource Card}">
                <StackPanel Spacing="10">
                    <Grid>
                        <TextBlock Text="実行結果" FontSize="18" FontWeight="SemiBold" />
                        <Button Content="ログを保存" Click="SaveLog_Click" HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock x:Name="Summary" Text="ハードウェアテストを準備しています。" Foreground="#ACBDD1" />
                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                        FontFamily="Cascadia Mono,Consolas" FontSize="12" Height="190" />
                </StackPanel>
            </Border>
            <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="CPU: Windows Hypervisor Platform  /  GPU: Vulkan（VM）/ Direct3D 11（単体テスト）  /  UI: WinUI 3"
                Foreground="#7E94AB" FontSize="12" />
        </Grid>
    </ScrollViewer>
</Page>
